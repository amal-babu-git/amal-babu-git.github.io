---
// An article, set as a paper: front matter, the description as the abstract,
// numbered sections with a contents rail, and citation details at the end.
import type { MarkdownHeading } from "astro";
import { type CollectionEntry, getCollection } from "astro:content";
import PaperLayout, { type ContentsItem } from "./PaperLayout.astro";
import PostCover from "../components/covers/PostCover.astro";
import { hasCover } from "../components/covers/covers";
import { SITE_URL } from "../consts";
import {
	authorNames,
	byNewest,
	fullDate,
	numberedSections,
	readingMinutes,
	topicLabel,
	topicSlug,
} from "../utils/writing";

interface Props {
	post: CollectionEntry<"blog">;
	headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;
const { title, description, pubDate, updatedDate, authors, heroImage } = post.data;

const topic = topicSlug(post);
const names = authorNames(authors);
const minutes = readingMinutes(post);

const contents: ContentsItem[] = [
	{ id: "abstract", label: "Abstract" },
	...numberedSections(headings),
	{ id: "cite", label: "Cite this article" },
	{ id: "more-writing", label: "More writing" },
];

// Related writing: same topic first, then the newest.
const otherPosts = (await getCollection("blog"))
	.filter((other) => other.id !== post.id)
	.sort(
		(a, b) =>
			Number(topicSlug(b) === topic) - Number(topicSlug(a) === topic) || byNewest(a, b),
	)
	.slice(0, 3);

const bibtexName = (name: string) => {
	const parts = name.trim().split(/\s+/);
	return parts.length > 1 ? `${parts.at(-1)}, ${parts.slice(0, -1).join(" ")}` : name;
};
const year = pubDate.getFullYear();
const keyWord = post.id.split("/").at(-1)?.split("-")[0] ?? "post";
const articleUrl = new URL("/blog/" + post.id + "/", SITE_URL).href;
const bibtex = `@misc{babu${year}${keyWord},
  author       = {${names.map(bibtexName).join(" and ")}},
  title        = {${title.replace(/&/g, "\\&")}},
  year         = {${year}},
  howpublished = {\\url{${articleUrl}}}
}`;
---

<PaperLayout
	title={title}
	description={description}
	contents={contents}
	image={heroImage}
>
	<header
		slot="front"
		class="front"
	>
		<h1 class="paper-title is-article font-display">{title}</h1>
		<dl class="byline">
			<div>
				<dt>{names.length > 1 ? "Authors" : "Author"}</dt>
				<dd>{names.join(", ")}</dd>
			</div>
			<div>
				<dt>Published</dt>
				<dd>
					<time datetime={pubDate.toISOString()}>{fullDate(pubDate)}</time>
				</dd>
			</div>
			{
				updatedDate && (
					<div>
						<dt>Updated</dt>
						<dd>
							<time datetime={updatedDate.toISOString()}>{fullDate(updatedDate)}</time>
						</dd>
					</div>
				)
			}
			<div>
				<dt>Reading time</dt>
				<dd>{minutes} min</dd>
			</div>
			<div>
				<dt>Topic</dt>
				<dd>
					<a href={`/blog/category/${topic}/`}>{topicLabel(topic)}</a>
				</dd>
			</div>
		</dl>
	</header>

	<section
		id="abstract"
		class="abstract"
	>
		<p><strong>Abstract.</strong> {description}</p>
		{
			hasCover(post.id) && (
				<figure class="margin-figure">
					<div class="margin-figure-frame">
						<PostCover
							id={post.id}
							title={title}
						/>
					</div>
					<figcaption>A drawing of the example this article works through.</figcaption>
				</figure>
			)
		}
	</section>

	<div class="paper-body">
		<slot />
	</div>

	<section
		id="cite"
		class="appendix"
	>
		<h2 class="sec-title">Cite this article</h2>
		<div class="bibtex">
			<pre><code>{bibtex}</code></pre>
			<button
				type="button"
				class="copy-button"
				data-copy-bibtex
			>
				Copy BibTeX
			</button>
		</div>
	</section>

	<section
		id="more-writing"
		class="references"
	>
		<h2 class="sec-title">More writing</h2>
		<ul class="more-list">
			{
				otherPosts.map((other) => (
					<li>
						<a href={`/blog/${other.id}/`}>{other.data.title}</a>
						<span class="muted">
							{fullDate(other.data.pubDate)}, {topicLabel(topicSlug(other))}
						</span>
					</li>
				))
			}
		</ul>
		<p>
			<a
				class="text-link"
				href="/blog">All writing</a
			>
		</p>
	</section>
</PaperLayout>
