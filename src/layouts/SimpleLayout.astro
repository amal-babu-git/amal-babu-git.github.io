---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE } from "../consts";
import "../styles/global.css"; // Ensure global styles are imported

interface Props {
	title: string;
	description: string;
	image?: string;
}

const { title, description, image } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead
			title={title || SITE_TITLE}
			description={description}
			image={image}
		/>
	</head>
	<body class="flex flex-col min-h-screen">
		{/* Ensure footer sticks to bottom */}
		<Header />

		{/* Adjusted main content area */}
		<main class="flex-grow container mx-auto px-4 py-8 max-w-6xl">
			<div class="text-center mb-8">
				<h1 class="text-3xl font-bold mb-2">{title}</h1>
				{description && <p class="text-base-content/70">{description}</p>}
			</div>

			{/* Removed divider and prose class from wrapper */}
			<div class="max-w-none mx-auto text-base-content/95">
				<slot />
				{/* Content (like the login form) goes here */}
			</div>
		</main>

		<Footer />
	</body><!-- Structured data for better SEO -->
	<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "ProfilePage",
			"mainEntity": {
				"@type": "Person",
				"name": "Amal Babu",
				"url": "https://amal-babu-git.github.io",
				"jobTitle": "Full-Stack Developer & AI Specialist",
				"sameAs": [
					"https://github.com/amal-babu-git",
					"https://www.linkedin.com/in/amalbabudev"
				]
			}
		}
	</script>
</html>
