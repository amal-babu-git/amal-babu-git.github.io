---
// A client project, set as a paper: domain, role and year in the front
// matter, the description as the abstract with the stack beneath it, a
// modules table for ERP and CRM systems, numbered sections from the Markdown
// body, and the other projects at the end.
import type { MarkdownHeading } from "astro";
import { type CollectionEntry, getCollection } from "astro:content";
import PaperLayout, { type ContentsItem } from "./PaperLayout.astro";
import { numberedSections } from "../utils/writing";
import { ROLES, newestFirst } from "../utils/projects";

interface Props {
	project: CollectionEntry<"projects">;
	headings: MarkdownHeading[];
}

const { project, headings } = Astro.props;
const { title, description, domain, role, year, stack, modules } = project.data;

// The modules section comes before the Markdown body, so it's numbered first.
const modulesHeading: MarkdownHeading = { depth: 2, slug: "modules", text: "Modules" };

const contents: ContentsItem[] = [
	{ id: "abstract", label: "Abstract" },
	...numberedSections(modules ? [modulesHeading, ...headings] : headings),
	{ id: "more-projects", label: "More client projects" },
];

const otherProjects = (await getCollection("projects"))
	.filter((other) => other.id !== project.id)
	.sort(newestFirst);
---

<PaperLayout
	title={title}
	description={description}
	contents={contents}
>
	<header
		slot="front"
		class="front"
	>
		<h1 class="paper-title is-article font-display">{title}</h1>
		<dl class="byline">
			<div>
				<dt>Domain</dt>
				<dd>{domain}</dd>
			</div>
			<div>
				<dt>My role</dt>
				<dd>{ROLES[role].name}</dd>
			</div>
			<div>
				<dt>Year</dt>
				<dd>{year}</dd>
			</div>
			<div>
				<dt>Client</dt>
				<dd>Name withheld</dd>
			</div>
		</dl>
	</header>

	<section
		id="abstract"
		class="abstract"
	>
		<p><strong>Abstract.</strong> {description}</p>
		<aside class="note role-note">
			<p><strong>{ROLES[role].name}.</strong> {ROLES[role].description}</p>
		</aside>
		<p class="keywords"><span class="muted">Stack:</span> {stack.join(", ")}</p>
	</section>

	<div class="paper-body">
		{
			modules && (
				<>
					<h2 id={modulesHeading.slug}>{modulesHeading.text}</h2>
					<p class="tbl-caption">
						<strong>Table 1.</strong> The system's {modules.length} modules and what
						each one covers.
					</p>
					<div class="table-scroll">
						<table>
							<thead>
								<tr>
									<th scope="col">Module</th>
									<th scope="col">What it covers</th>
								</tr>
							</thead>
							<tbody>
								{modules.map((module) => (
									<tr>
										<th scope="row">{module.name}</th>
										<td>{module.covers}</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</>
			)
		}
		<slot />
	</div>

	<section
		id="more-projects"
		class="references"
	>
		<h2 class="sec-title">More client projects</h2>
		<ul class="more-list">
			{
				otherProjects.map((other) => (
					<li>
						<a href={`/client-projects/${other.id}/`}>{other.data.title}</a>
						<span class="muted">
							{other.data.domain}, {ROLES[other.data.role].name.toLowerCase()}
						</span>
					</li>
				))
			}
		</ul>
		<p>
			<a
				class="text-link"
				href="/client-projects">All client projects</a
			>
		</p>
	</section>
</PaperLayout>

<style>
	/* The role note sits beside both the abstract and the stack line, so a
	   short abstract doesn't leave a gap above the stack. */
	@media (min-width: 1100px) {
		.role-note {
			grid-row: span 2;
		}
	}
</style>
