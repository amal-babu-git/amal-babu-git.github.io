---
import SimpleLayout from "../layouts/SimpleLayout.astro";
---

<SimpleLayout
	title="Our Services"
	description="Comprehensive technology solutions designed to help your business scale and succeed in the digital landscape."
>
	<!-- Services Overview -->
	<section class="mb-16">
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body">
				<h2
					class="card-title text-2xl font-semibold mb-6 border-b border-base-300 pb-2"
				>
					Our Core Services
				</h2>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<div>
						<p class="text-base text-base-content/80 mb-4">
							At ABK DataLab, we provide end-to-end technology solutions that
							address real business challenges. Our expert team leverages the
							latest technologies to deliver high-quality results tailored to
							your specific needs.
						</p>
						<p class="text-base text-base-content/80 mb-4">
							Whether you're looking to develop a custom web application,
							generate brand-specific images with AI, build a mobile app, or
							improve your search engine visibility, we have the expertise and
							experience to help you achieve your goals.
						</p>
					</div>
					<div class="bg-base-200 rounded-lg p-6">
						<h3 class="font-semibold mb-3">Why Choose Our Services</h3>
						<ul class="list-disc list-inside space-y-1 text-base-content/90">
							<li>Expert team with proven track record</li>
							<li>Customized solutions tailored to your needs</li>
							<li>Transparent communication throughout the process</li>
							<li>Ongoing support and maintenance</li>
							<li>Competitive pricing with excellent value</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Detailed Services Section -->
	<section class="mb-16 space-y-8">
		<!-- Web Development -->
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body">
				<h2 class="card-title text-xl font-semibold">
					Custom Web Development Solutions
				</h2>
				<p class="mb-4 text-base text-base-content/80">
					Create powerful, scalable web applications with our expert development
					team. From concept to deployment, we deliver high-performance
					solutions tailored to your business needs using cutting-edge
					technologies.
				</p>

				<div class="overflow-x-auto">
					<table class="table table-zebra">
						<thead>
							<tr>
								<th>Services</th>
								<th>Availability</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td>Responsive design for all devices</td>
								<td><span class="text-base-content/70">✓</span></td>
							</tr>
							<tr>
								<td>Frontend development with React.js</td>
								<td><span class="text-base-content/70">✓</span></td>
							</tr>
							<tr>
								<td>Backend development with Django/Python</td>
								<td><span class="text-base-content/70">✓</span></td>
							</tr>
							<tr>
								<td>Database design and optimization</td>
								<td><span class="text-base-content/70">✓</span></td>
							</tr>
							<tr>
								<td>API development and integration</td>
								<td><span class="text-base-content/70">✓</span></td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>

		<!-- Custom Image Generation -->
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body">
				<h2 class="card-title text-xl font-semibold">
					Custom Image Generation with LoRA Fine-Tuning
				</h2>
				<p class="mb-4 text-base text-base-content/80">
					Create unique, customized images tailored to your brand using advanced
					AI. Our LoRA fine-tuning process ensures high-quality, consistent
					results that match your specific style and requirements.
				</p>

				<div class="overflow-x-auto">
					<table class="table table-zebra">
						<thead>
							<tr>
								<th>Services</th>
								<th>Availability</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td>Brand-specific image generation</td>
								<td><span class="text-base-content/70">✓</span></td>
							</tr>
							<tr>
								<td>LoRA fine-tuning for consistent style</td>
								<td><span class="text-base-content/70">✓</span></td>
							</tr>
							<tr>
								<td>High-resolution outputs</td>
								<td><span class="text-base-content/70">✓</span></td>
							</tr>
							<tr>
								<td>Custom training on your content</td>
								<td><span class="text-base-content/70">✓</span></td>
							</tr>
							<tr>
								<td>Integration with marketing systems</td>
								<td><span class="text-base-content/70">✓</span></td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>

		<!-- Mobile App Development -->
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body">
				<h2 class="card-title text-xl font-semibold">Mobile App Development</h2>
				<p class="mb-4 text-base text-base-content/80">
					Turn your ideas into powerful mobile experiences with our expert
					development team. We build native and cross-platform apps that deliver
					exceptional user experiences across iOS and Android devices.
				</p>

				<div class="overflow-x-auto">
					<table class="table table-zebra">
						<thead>
							<tr>
								<th>Services</th>
								<th>Availability</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td>Native iOS and Android development</td>
								<td><span class="text-base-content/70">✓</span></td>
							</tr>
							<tr>
								<td>Cross-platform solutions</td>
								<td><span class="text-base-content/70">✓</span></td>
							</tr>
							<tr>
								<td>UI/UX design for mobile</td>
								<td><span class="text-base-content/70">✓</span></td>
							</tr>
							<tr>
								<td>App store optimization</td>
								<td><span class="text-base-content/70">✓</span></td>
							</tr>
							<tr>
								<td>Ongoing maintenance and updates</td>
								<td><span class="text-base-content/70">✓</span></td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>

		<!-- SEO Optimization -->
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body">
				<h2 class="card-title text-xl font-semibold">SEO Optimization</h2>
				<p class="mb-4 text-base text-base-content/80">
					Boost your online visibility and drive organic traffic with our
					comprehensive SEO services. From technical optimization to content
					strategy, we help your business achieve higher search engine rankings
					and connect with your target audience.
				</p>

				<div class="overflow-x-auto">
					<table class="table table-zebra">
						<thead>
							<tr>
								<th>Services</th>
								<th>Availability</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td>Technical SEO audits</td>
								<td><span class="text-base-content/70">✓</span></td>
							</tr>
							<tr>
								<td>Keyword research and strategy</td>
								<td><span class="text-base-content/70">✓</span></td>
							</tr>
							<tr>
								<td>On-page optimization</td>
								<td><span class="text-base-content/70">✓</span></td>
							</tr>
							<tr>
								<td>Content creation and optimization</td>
								<td><span class="text-base-content/70">✓</span></td>
							</tr>
							<tr>
								<td>Performance tracking and analytics</td>
								<td><span class="text-base-content/70">✓</span></td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</section>
</SimpleLayout>
