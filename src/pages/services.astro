---
import SimpleLayout from "../layouts/SimpleLayout.astro";
---

<SimpleLayout
	title="Our Services"
	description="Comprehensive technology solutions designed to help your business scale and succeed in the digital landscape."
>
	<!-- Services Overview -->
	<section class="mb-16">
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body">
				<h2
					class="card-title text-2xl font-semibold mb-6 border-b border-base-300 pb-2"
				>
					Our Core Services
				</h2>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<div>
						<p class="mb-4">
							At ABK DataLab, we provide end-to-end technology solutions that
							address real business challenges. Our expert team leverages the
							latest technologies to deliver high-quality results tailored to
							your specific needs.
						</p>
						<p>
							Whether you're looking to develop a custom web application,
							generate brand-specific images with AI, build a mobile app, or
							improve your search engine visibility, we have the expertise and
							experience to help you achieve your goals.
						</p>
					</div>
					<div class="bg-base-200 rounded-lg p-6">
						<h3 class="font-semibold mb-3">Why Choose Our Services</h3>
						<ul class="list-disc list-inside space-y-1">
							<li>Expert team with proven track record</li>
							<li>Customized solutions tailored to your needs</li>
							<li>Transparent communication throughout the process</li>
							<li>Ongoing support and maintenance</li>
							<li>Competitive pricing with excellent value</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Detailed Services Section -->
	<section class="mb-16 space-y-8">
		<!-- Web Development -->
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body">
				<h2 class="card-title text-xl font-semibold">
					Custom Web Development Solutions
				</h2>
				<p class="mb-4">
					Create powerful, scalable web applications with our expert development
					team. From concept to deployment, we deliver high-performance
					solutions tailored to your business needs using cutting-edge
					technologies.
				</p>

				<div class="overflow-x-auto">
					<table class="table table-zebra">
						<thead>
							<tr>
								<th>Services</th>
								<th>Availability</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td>Responsive design for all devices</td>
								<td><span class="badge badge-success">✓</span></td>
							</tr>
							<tr>
								<td>Frontend development with React.js</td>
								<td><span class="badge badge-success">✓</span></td>
							</tr>
							<tr>
								<td>Backend development with Django/Python</td>
								<td><span class="badge badge-success">✓</span></td>
							</tr>
							<tr>
								<td>Database design and optimization</td>
								<td><span class="badge badge-success">✓</span></td>
							</tr>
							<tr>
								<td>API development and integration</td>
								<td><span class="badge badge-success">✓</span></td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>

		<!-- Custom Image Generation -->
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body">
				<h2 class="card-title text-xl font-semibold">
					Custom Image Generation with LoRA Fine-Tuning
				</h2>
				<p class="mb-4">
					Create unique, customized images tailored to your brand using advanced
					AI. Our LoRA fine-tuning process ensures high-quality, consistent
					results that match your specific style and requirements.
				</p>

				<div class="overflow-x-auto">
					<table class="table table-zebra">
						<thead>
							<tr>
								<th>Services</th>
								<th>Availability</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td>Brand-specific image generation</td>
								<td><span class="badge badge-success">✓</span></td>
							</tr>
							<tr>
								<td>LoRA fine-tuning for consistent style</td>
								<td><span class="badge badge-success">✓</span></td>
							</tr>
							<tr>
								<td>High-resolution outputs</td>
								<td><span class="badge badge-success">✓</span></td>
							</tr>
							<tr>
								<td>Custom training on your content</td>
								<td><span class="badge badge-success">✓</span></td>
							</tr>
							<tr>
								<td>Integration with marketing systems</td>
								<td><span class="badge badge-success">✓</span></td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>

		<!-- Mobile App Development -->
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body">
				<h2 class="card-title text-xl font-semibold">Mobile App Development</h2>
				<p class="mb-4">
					Turn your ideas into powerful mobile experiences with our expert
					development team. We build native and cross-platform apps that deliver
					exceptional user experiences across iOS and Android devices.
				</p>

				<div class="overflow-x-auto">
					<table class="table table-zebra">
						<thead>
							<tr>
								<th>Services</th>
								<th>Availability</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td>Native iOS and Android development</td>
								<td><span class="badge badge-success">✓</span></td>
							</tr>
							<tr>
								<td>Cross-platform solutions</td>
								<td><span class="badge badge-success">✓</span></td>
							</tr>
							<tr>
								<td>UI/UX design for mobile</td>
								<td><span class="badge badge-success">✓</span></td>
							</tr>
							<tr>
								<td>App store optimization</td>
								<td><span class="badge badge-success">✓</span></td>
							</tr>
							<tr>
								<td>Ongoing maintenance and updates</td>
								<td><span class="badge badge-success">✓</span></td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>

		<!-- SEO Optimization -->
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body">
				<h2 class="card-title text-xl font-semibold">SEO Optimization</h2>
				<p class="mb-4">
					Boost your online visibility and drive organic traffic with our
					comprehensive SEO services. From technical optimization to content
					strategy, we help your business achieve higher search engine rankings
					and connect with your target audience.
				</p>

				<div class="overflow-x-auto">
					<table class="table table-zebra">
						<thead>
							<tr>
								<th>Services</th>
								<th>Availability</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td>Technical SEO audits</td>
								<td><span class="badge badge-success">✓</span></td>
							</tr>
							<tr>
								<td>Keyword research and strategy</td>
								<td><span class="badge badge-success">✓</span></td>
							</tr>
							<tr>
								<td>On-page optimization</td>
								<td><span class="badge badge-success">✓</span></td>
							</tr>
							<tr>
								<td>Content creation and optimization</td>
								<td><span class="badge badge-success">✓</span></td>
							</tr>
							<tr>
								<td>Performance tracking and analytics</td>
								<td><span class="badge badge-success">✓</span></td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</section>

	<!-- Process Section -->
	<section class="mb-16">
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body">
				<h2
					class="card-title text-2xl font-semibold mb-6 border-b border-base-300 pb-2"
				>
					Our Process
				</h2>
				<p class="mb-6">
					Our streamlined approach ensures efficient delivery of high-quality
					solutions
				</p>

				<div class="grid grid-cols-1 md:grid-cols-4 gap-4">
					<div class="card bg-base-200">
						<div class="card-body p-5">
							<h3 class="card-title text-lg">Discovery</h3>
							<p>
								We begin by understanding your business needs and objectives.
							</p>
						</div>
					</div>

					<div class="card bg-base-200">
						<div class="card-body p-5">
							<h3 class="card-title text-lg">Planning</h3>
							<p>
								Creating a strategic roadmap to achieve your goals efficiently.
							</p>
						</div>
					</div>

					<div class="card bg-base-200">
						<div class="card-body p-5">
							<h3 class="card-title text-lg">Execution</h3>
							<p>
								Implementing solutions with agile methodology for optimal
								results.
							</p>
						</div>
					</div>

					<div class="card bg-base-200">
						<div class="card-body p-5">
							<h3 class="card-title text-lg">Support</h3>
							<p>
								Providing ongoing maintenance and improvements to ensure
								success.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- FAQ Section -->
	<section class="mb-16">
		<div class="card bg-base-100 shadow-sm">
			<div class="card-body">
				<h2
					class="card-title text-2xl font-semibold mb-6 border-b border-base-300 pb-2"
				>
					Frequently Asked Questions
				</h2>

				<div class="join join-vertical w-full">
					<div class="collapse collapse-arrow join-item">
						<input
							type="radio"
							name="faq-accordion"
							checked="checked"
						/>
						<div class="collapse-title text-lg font-medium">
							How long does it typically take to complete a web development
							project?
						</div>
						<div class="collapse-content">
							<p>
								Project timelines vary based on complexity, but most custom
								websites take 4-8 weeks from concept to launch. Web applications
								with advanced functionality may take 3-6 months.
							</p>
						</div>
					</div>

					<div class="collapse collapse-arrow join-item">
						<input
							type="radio"
							name="faq-accordion"
						/>
						<div class="collapse-title text-lg font-medium">
							Do you offer ongoing maintenance and support after launch?
						</div>
						<div class="collapse-content">
							<p>
								Yes, we provide ongoing maintenance and support services to
								ensure your project continues to run smoothly after launch. We
								offer various support packages tailored to different needs and
								budgets.
							</p>
						</div>
					</div>

					<div class="collapse collapse-arrow join-item">
						<input
							type="radio"
							name="faq-accordion"
						/>
						<div class="collapse-title text-lg font-medium">
							What technologies do you specialize in?
						</div>
						<div class="collapse-content">
							<p>
								Our team specializes in a range of modern technologies including
								Python (Django, FastAPI), JavaScript/TypeScript (React,
								Node.js), various database systems (PostgreSQL, MongoDB), and
								machine learning frameworks (TensorFlow, PyTorch). We select the
								most appropriate technology stack based on your project
								requirements.
							</p>
						</div>
					</div>

					<div class="collapse collapse-arrow join-item">
						<input
							type="radio"
							name="faq-accordion"
						/>
						<div class="collapse-title text-lg font-medium">
							How do you handle project communication and updates?
						</div>
						<div class="collapse-content">
							<p>
								We believe in transparent and consistent communication.
								Throughout your project, you'll receive regular updates through
								scheduled meetings and progress reports. We use project
								management tools that allow you to track development in
								real-time and provide feedback.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA Section -->
    <section>
        <div class="card bg-base-200">
            <div class="card-body p-8 text-center">
                <h2 class="card-title text-2xl font-semibold justify-center mb-4">
                    Ready to Transform Your Business?
                </h2>
                <p class="mb-6 max-w-2xl mx-auto">
                    Contact us today to discuss how our services can help your business
                    grow and succeed in the digital landscape.
                </p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					
					<a
						href="mailto:developer.amalbabu@gmail.com"
						class="btn btn-outline"
						>developer.amalbabu@gmail.com</a
					>
				</div>
            </div>
        </div>
    </section>
</SimpleLayout>
