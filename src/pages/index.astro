---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import EmailSubscribe from "../components/EmailSubscribe";
import PostCard from "../components/ui/PostCard.astro";
import CTASection from "../components/ui/CTASection.astro";

// Get all blog posts sorted by date
const allPosts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Filter featured posts and limit to 3
const featuredPosts = allPosts
	.filter((post) => post.data.featured === true)
	.slice(0, 3);

// Get recent posts (excluding featured ones to avoid duplication)
const recentPosts = allPosts.filter((post) => !post.data.featured).slice(0, 3);

// Display featured posts if available, otherwise fall back to recent posts
const postsToDisplay = featuredPosts.length > 0 ? featuredPosts : recentPosts;

const PERSONAL_TITLE =
	"Amal Babu · ABK Datalab - Software Engineer, Full Stack Developer, Tech Writer";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={PERSONAL_TITLE}
			description={SITE_DESCRIPTION}
		/>
		<meta
			name="keywords"
			content="Software Engineer, Tech Writer, Full-Stack Development, React Developer, Next.js Expert, TypeScript Development, Amal Babu, ABK Datalab, Python Developer, Machine Learning, AI, Gen AI, FastAPI, Django"
		/>
	</head>
	<body>
		<Header />
		<div class="container mx-auto px-4">
			<main class="max-w-5xl mx-auto mb-16">
				<!-- Hero Section -->
				<section class="mb-12 my-8">
					<div class="card bg-base-100 shadow-sm">
						<div class="card-body">
							<h2
								class="text-2xl font-semibold mb-4 border-b border-base-200 pb-2"
							>
								Amal Babu . ABK DataLab
							</h2>
							<div class="text-base text-base-content/80">
								<p class="mb-4">
									Welcome to my digital space. Here, I share
									my projects, professional journey, and
									personal insights into modern web
									technologies, AI innovations, and software
									engineering.
								</p>
								<div
									class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6"
								>
									<div>
										<h3
											class="font-semibold text-base-content mb-2"
										>
											My Work
										</h3>
										<p class="text-sm text-base-content/70">
											Building full-stack web applications
											using modern frameworks, integrating
											AI capabilities, and exploring
											emerging technologies like RAG
											systems and intelligent agents.
										</p>
									</div>
									<div>
										<h3
											class="font-semibold text-base-content mb-2"
										>
											Blog & Articles
										</h3>
										<p class="text-sm text-base-content/70">
											Personal perspectives on emerging
											technologies, development
											experiences, AI innovations, and
											industry trends that shape the
											future of software development.
										</p>
									</div>
								</div>
							</div>
							<div class="flex flex-wrap gap-2 mt-6">
								<span class="badge badge-outline">Python</span>
								<span class="badge badge-outline">FastAPI</span>
								<span class="badge badge-outline">Django</span>
								<span class="badge badge-outline"
									>JavaScript</span
								>
								<span class="badge badge-outline">React</span>
								<span class="badge badge-outline">Next.js</span>
								<span class="badge badge-outline"
									>PostgreSQL</span
								>
								<span class="badge badge-outline"
									>Machine Learning</span
								>
								<span class="badge badge-outline"
									>Generative AI</span
								>
								<span class="badge badge-outline">RAGs</span>
								<span class="badge badge-outline"
									>Agentic AI</span
								>
								<span class="badge badge-outline"
									>Containerization - Docker</span
								>
								<span class="badge badge-outline">ComfyUI</span>
								<span class="badge badge-outline"
									>LoRA Models</span
								>
								<span class="badge badge-outline"
									>Image Generation</span
								>
							</div>
							<div
								class="flex flex-wrap justify-center md:justify-start gap-4 mt-6"
							>
								<a
									href="/about"
									class="btn btn-neutral"
									>About Me</a
								>
								<a
									href="#contact"
									class="btn btn-outline"
									>Contact Me</a
								>
							</div>
						</div>
					</div>
				</section>

				<!-- Featured Posts Section -->
				{
					postsToDisplay.length > 0 && (
						<section class="mb-12">
							<div class="flex justify-between items-center mb-6">
								<h2 class="text-2xl font-semibold border-b border-base-300 pb-2 w-full">
									{featuredPosts.length > 0
										? "Featured Articles"
										: "Latest Articles"}
								</h2>
							</div>
							<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
								{postsToDisplay.map((post) => (
									<PostCard
										post={post}
										defaultImage="/images/blog/thumbnail.png"
									/>
								))}
							</div>
							<div class="flex justify-end mt-4">
								<a
									href="/blog"
									class="btn btn-ghost btn-sm"
								>
									View All Articles →
								</a>
							</div>
						</section>
					)
				}

				<!-- Key Topics Section -->
				<section class="mb-12">
					<h2
						class="text-2xl font-semibold mb-6 border-b border-base-300 pb-2"
					>
						Key Topics
					</h2>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						<div class="card bg-base-100 shadow-sm">
							<div class="card-body">
								<h3 class="card-title">Backend Development</h3>
								<p>
									Optimize your API services with Python using
									FastAPI and Django, with practical examples
									focused on performance, security, and
									maintainability.
								</p>
							</div>
						</div>
						<div class="card bg-base-100 shadow-sm">
							<div class="card-body">
								<h3 class="card-title">Frontend Development</h3>
								<p>
									Implement responsive and interactive user
									interfaces with step-by-step tutorials for
									React, Next.js, and modern CSS frameworks.
								</p>
							</div>
						</div>
						<div class="card bg-base-100 shadow-sm">
							<div class="card-body">
								<h3 class="card-title">
									AI & Machine Learning
								</h3>
								<p>
									Apply machine learning models to real-world
									problems with practical implementations
									using Python, TensorFlow, and related
									technologies.
								</p>
							</div>
						</div>
						<div class="card bg-base-100 shadow-sm">
							<div class="card-body">
								<h3 class="card-title">DevOps & Cloud</h3>
								<p>
									Set up efficient deployment workflows using
									Docker, CI/CD pipelines, and cloud services
									for scalable infrastructure.
								</p>
							</div>
						</div>
					</div>
				</section>

				<!-- Resources Section
				{guides.length > 0 && (
					<section class="mb-12">
						<h2 class="text-2xl font-semibold mb-6 border-b border-base-300 pb-2">Technical Guides</h2>
						<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
							{guides.map((guide) => (
								<div class="card bg-base-100 shadow-md hover:shadow-lg transition-all duration-300">
									<div class="card-body p-5">
										<h3 class="card-title text-lg">{guide.data.title}</h3>
										<p class="text-sm line-clamp-2 my-2">{guide.data.description}</p>
										<div class="card-actions justify-end mt-2">
											<a href={`/guides/${guide.id}/`} class="btn btn-sm btn-outline">View Guide</a>
										</div>
									</div>
								</div>
							))}
						</div>
						<div class="flex justify-end mt-4">
							<a href="/guides" class="btn btn-ghost btn-sm">Browse All Guides →</a>
						</div>
					</section>
				)} -->

				<!-- Subscribe Section -->
				<EmailSubscribe />

				<!-- Contact Section -->
				<CTASection />

				<!-- Connect Section -->
				<section class="mt-12 card bg-base-100 shadow-sm">
					<div class="card-body p-6">
						<div
							class="flex justify-center items-center flex-col text-center"
						>
							<h2 class="text-xl font-semibold mb-3">
								Let's Connect
							</h2>
							<p class="mb-4 max-w-md">
								Interested in discussing technology, exploring
								collaboration opportunities, or just want to say
								hi? Feel free to reach out.
							</p>
							<div class="flex gap-3">
								<a
									href="https://github.com/amal-babu-git"
									target="_blank"
									rel="noopener noreferrer"
									class="btn btn-sm btn-outline"
								>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										width="16"
										height="16"
										viewBox="0 0 24 24"
										class="fill-current mr-1"
										><path
											d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
										></path></svg
									>
									Portfolio
								</a>
								<a
									href="mailto:developer.amalbabu@gmail.com"
									class="btn btn-sm btn-primary"
								>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										width="16"
										height="16"
										fill="currentColor"
										viewBox="0 0 16 16"
										class="mr-1"
									>
										<path
											d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z"
										></path>
									</svg>
									Contact Me
								</a>
							</div>
						</div>
					</div>
				</section>
			</main>
		</div>
		<Footer />
	</body>
</html>
