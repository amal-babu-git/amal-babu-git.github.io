---
// The homepage, structured like a short research paper that introduces the
// author: an abstract that states the approach, then writing (§1), client
// projects (§2) and open source and research (§3), each summarized and linked
// to the full page. References index the site; About has the work history.
import PaperLayout from "../layouts/PaperLayout.astro";
import SystemDiagram from "../components/SystemDiagram.astro";
import WritingEntry from "../components/paper/WritingEntry.astro";
import Cite from "../components/paper/Cite.astro";
import RefNote from "../components/paper/RefNote.astro";
import { getCollection } from "astro:content";
import { SOCIAL_LINKS, RESUME_URL, SITE_URL, SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { ROLES, newestFirst } from "../utils/projects";
import { byNewest } from "../utils/writing";

const APPROACH = "coding-and-development/structure-first-business-software";

// Set by hand: change it when the content of this page changes.
const REVISED = new Date("2026-10-10");

const posts = (await getCollection("blog")).sort(byNewest);
const projects = (await getCollection("projects")).sort(newestFirst);
const postById = new Map(posts.map((post) => [post.id, post]));
const monthYear = (date: Date) =>
	date.toLocaleDateString("en-us", { month: "short", year: "numeric" });

// §1 shows three articles: pinned ones first, then featured ones, newest
// first. The Writing page has them all.
const WRITING_LIMIT = 3;
const pinned = posts.filter((post) => post.data.pinned);
const featured = posts.filter((post) => post.data.featured && !post.data.pinned);
const selected = [...pinned, ...featured];
const shownPosts = (selected.length > 0 ? selected : posts).slice(0, WRITING_LIMIT);

const NUMBER_WORDS = ["no", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"];
const inWords = (n: number) => NUMBER_WORDS[n] ?? String(n);
const projectCount = inWords(projects.length);

type Reference = {
	key: string;
	title: string;
	source: string;
	url: string;
	extra?: { name: string; url: string }[];
};

const postReference = (key: string, id: string): Reference | null => {
	const post = postById.get(id);
	if (!post) return null;
	return {
		key,
		title: post.data.title,
		source: `Writing, ${monthYear(post.data.pubDate)}`,
		url: `/blog/${post.id}/`,
	};
};

// Numbered in order of first citation, as in a paper.
const cited: (Reference | null)[] = [
	postReference("approach", APPROACH),
	{
		key: "template",
		title: "FastAPI backend template",
		source: "Hybrid Interactive, open source on GitHub",
		url: "https://github.com/hybridinteract/fastapi-template",
	},
	{
		key: "cli",
		title: "fastapi-admin-cli",
		source: "Open source, published on PyPI",
		url: "https://pypi.org/project/fastapi-admin-cli/",
		extra: [
			{ name: "GitHub", url: "https://github.com/amal-babu-git/fastapi-admin-cli" },
			{ name: "Documentation", url: "https://amal-babu-git.github.io/fastapi-admin-cli-docs/" },
		],
	},
	{
		key: "skimlit",
		title: "SkimLit: medical abstract classification",
		source: "Research paper, IJRAR",
		url: "https://www.ijrar.org/papers/IJRAR1DUP049.pdf",
	},
];

// Articles the text doesn't cite still appear in the references, after the
// cited ones, newest first.
const uncited = posts
	.filter((post) => post.id !== APPROACH)
	.map((post) => postReference(post.id, post.id));

const references = [...cited, ...uncited].filter((r): r is Reference => r !== null);
const num: Record<string, number> = Object.fromEntries(
	references.map((reference, i) => [reference.key, i + 1]),
);
const ref = (key: string) => references.find((reference) => reference.key === key);

const revised = REVISED.toLocaleDateString("en-us", { month: "long", year: "numeric" });

// Index pages take a plain label as their title (Writing, Client projects),
// so the homepage, an index of the author's work, takes the author's name.
const TITLE = "Amal Babu";
const SUBTITLE = "Software architecture, business systems and applied AI";

const pageUrl = new URL("/", SITE_URL).href;
const bibtex = `@misc{babu${REVISED.getFullYear()}business,
  author       = {Babu, Amal},
  title        = {${SUBTITLE}},
  year         = {${REVISED.getFullYear()}},
  howpublished = {\\url{${pageUrl}}}
}`;

const PAGE_TITLE = `${SITE_TITLE} | Full-stack developer and tech lead`;

const contents = [
	{ id: "abstract", label: "Abstract" },
	{ id: "writing", n: "1", label: "Writing" },
	{ id: "client-projects", n: "2", label: "Client projects" },
	{ id: "published", n: "3", label: "Open source and research" },
	{ id: "correspondence", label: "Correspondence" },
	{ id: "references", label: "References" },
	{ id: "cite", label: "Cite this page" },
];

const published = [
	{
		name: "FastAPI backend template",
		summary:
			"Hybrid Interactive's official backend template: async SQLAlchemy 2.0 with Alembic, Celery and Redis for background jobs, and JWT authentication with role-based access control.",
		key: "template",
	},
	{
		name: "fastapi-admin-cli",
		summary:
			"A Django-inspired command-line tool that scaffolds a structured FastAPI project, generates modules inside it, and runs Docker and Alembic tasks.",
		key: "cli",
	},
	{
		name: "SkimLit",
		summary:
			"An NLP model that labels each sentence of a medical abstract as an objective, a method or a conclusion. Published as a research paper in IJRAR.",
		key: "skimlit",
	},
];
---

<PaperLayout
	title={PAGE_TITLE}
	description={SITE_DESCRIPTION}
	contents={contents}
>
	<meta
		slot="head"
		name="keywords"
		content="Amal Babu, Full-Stack Developer, Tech Lead, Software Architecture, System Design, Business Software, FastAPI, Django, Next.js, PostgreSQL, AI Integration, Pydantic AI, LangGraph"
	/>

	<header
		slot="front"
		class="front"
	>
		<h1 class="paper-title font-display">{TITLE}</h1>
		<p class="paper-subtitle">{SUBTITLE}</p>
		<dl class="byline">
			<div>
				<dt>Role</dt>
				<dd>Full-stack developer and tech lead</dd>
			</div>
			<div>
				<dt>Affiliation</dt>
				<dd>Hybrid Interactive, Kochi</dd>
			</div>
			<div>
				<dt>Revised</dt>
				<dd>{revised}</dd>
			</div>
			<div>
				<dt>Correspondence</dt>
				<dd>
					<a href={`mailto:${SOCIAL_LINKS.email}`}>{SOCIAL_LINKS.email}</a>
				</dd>
			</div>
		</dl>
	</header>

	<section
		id="abstract"
		class="abstract"
	>
		<p>
			<strong>Abstract.</strong> I'm Amal Babu, a full-stack software developer
			and tech lead at Hybrid Interactive in Kochi, India. I build scalable
			software that solves business problems, including ERP and CRM systems, for
			clients in healthcare, construction, e&#8209;commerce and influencer
			marketing, and I add AI where it does useful work. Across all of it I put
			structure first: clear module boundaries, dependencies that point one way,
			and a data model that fits the domain. In my experience, that's what keeps
			a system easy to change as it grows <Cite n={num.approach ?? 0} />. I've
			led {projectCount} client systems as technical lead. This page is a guide
			to my writing and my work. My full work history, skills and education are
			on the <a
				class="text-link"
				href="/about">About page</a
			>.
		</p>
		<aside class="note">
			<RefNote
				n={num.approach ?? 0}
				reference={ref("approach")}
			/>
		</aside>
		<p class="keywords">
			<span class="muted">Keywords:</span> software architecture, system design,
			full-stack development, domain-driven design, FastAPI, Django, Next.js,
			PostgreSQL, AI integration
		</p>
	</section>

	<section id="writing">
		<h2 class="sec-title">
			<span class="sec-n">1</span>Writing
		</h2>
		<p>
			The first article sets out the approach behind all of my work <Cite
				n={num.approach ?? 0}
			/>. The others are the ones I'd read next.
		</p>
		{
			shownPosts.map((post, i) => (
				<WritingEntry
					post={post}
					n={`1.${i + 1}`}
				/>
			))
		}
		<p class="writing-more">
			All {inWords(posts.length)} articles are on the <a
				class="text-link"
				href="/blog">Writing page</a
			>, and new ones appear in the <a
				class="text-link"
				href="/rss.xml">RSS feed</a
			>.
		</p>
	</section>

	<section id="client-projects">
		<h2 class="sec-title">
			<span class="sec-n">2</span>Client projects
		</h2>
		<p>
			I've been at Hybrid Interactive since May 2025, leading a small team. <a
				class="xref"
				href="#table-1">Table 1</a
			> lists the client systems I've led there, most recent first. The clients
			are confidential, so each project is described rather than named. Each one
			links to a fuller write-up, and all of them are on the <a
				class="text-link"
				href="/client-projects">Client projects page</a
			>.
		</p>
		<aside class="note">
			<p>
				On every project I was technical lead: I led the project and its system
				design, directed the team and made the key technical decisions. Where
				noted, I also developed the core modules. Every role I've held is on the <a
					class="text-link"
					href="/about">About page</a
				> and in my <a
					class="text-link"
					href={RESUME_URL}>résumé</a
				>.
			</p>
		</aside>
		<div
			id="table-1"
			class="table-block"
		>
			<p class="tbl-caption">
				<strong>Table 1.</strong> Client projects, most recent first, with my
				role on each.
			</p>
			<div class="table-scroll">
				<table>
					<thead>
						<tr>
							<th scope="col">Project</th>
							<th scope="col">Domain</th>
							<th scope="col">My role</th>
						</tr>
					</thead>
					<tbody>
						{
							projects.map((project) => (
								<tr>
									<th scope="row">
										<a
											class="project-link"
											href={`/client-projects/${project.id}/`}
										>
											{project.data.title}
										</a>
									</th>
									<td>{project.data.domain}</td>
									<td>{ROLES[project.data.role].name}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</div>
		<p>
			<a
				class="xref"
				href="#figure-1">Figure 1</a
			> shows the architecture these systems share, as set out in <Cite
				n={num.approach ?? 0}
			/>. Frontends talk to one API layer. Behind it, the backend is a single
			deployable divided into business modules, which share only core
			infrastructure. Many of these backends start from our open-source template <Cite
				n={num.template ?? 0}
			/>.
		</p>
		<aside class="note">
			<p>
				Every box in Figure 1 links to the work behind it. Select one to see
				where it came from.
			</p>
		</aside>
		<div
			id="figure-1"
			class="figure"
		>
			<SystemDiagram
				figureLabel="Figure 1."
				caption="The architecture the systems in Table 1 share. Select a box to see the work behind it."
			/>
		</div>
	</section>

	<section id="published">
		<h2 class="sec-title">
			<span class="sec-n">3</span>Open source and research
		</h2>
		<p>
			<a
				class="xref"
				href="#table-2">Table 2</a
			> lists what I've published: two open-source tools for structuring FastAPI
			backends, and one research paper. Both tools are on GitHub, and the CLI is
			also on PyPI. The design decisions behind each are on the <a
				class="text-link"
				href="/projects">Systems page</a
			>, and my other code is at <a
				class="text-link"
				href={SOCIAL_LINKS.github}>github.com/amal-babu-git</a
			>.
		</p>
		<div
			id="table-2"
			class="table-block"
		>
			<p class="tbl-caption">
				<strong>Table 2.</strong> Open-source tools and research.
			</p>
			<div class="table-scroll">
				<table>
					<thead>
						<tr>
							<th scope="col">Work</th>
							<th scope="col">What it is</th>
							<th
								scope="col"
								class="num">Ref.</th
							>
						</tr>
					</thead>
					<tbody>
						{
							published.map((row) => (
								<tr>
									<th scope="row">{row.name}</th>
									<td>{row.summary}</td>
									<td class="num">
										<Cite n={num[row.key] ?? 0} />
									</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<section
		id="correspondence"
		class="statement"
	>
		<h2 class="sec-title">Correspondence</h2>
		<p>
			Email is the quickest way to reach me: <a
				class="text-link"
				href={`mailto:${SOCIAL_LINKS.email}`}>{SOCIAL_LINKS.email}</a
			>. I'm also on <a
				class="text-link"
				href={SOCIAL_LINKS.linkedin}>LinkedIn</a
			>, <a
				class="text-link"
				href={SOCIAL_LINKS.github}>GitHub</a
			>, <a
				class="text-link"
				href={SOCIAL_LINKS.leetcode}>LeetCode</a
			> and <a
				class="text-link"
				href={SOCIAL_LINKS.medium}>Medium</a
			>, and my <a
				class="text-link"
				href={RESUME_URL}>résumé</a
			> has the full record.
		</p>
	</section>

	<section
		id="references"
		class="references"
	>
		<h2 class="sec-title">References</h2>
		<ol class="ref-list">
			{
				references.map((reference, i) => (
					<li id={`ref-${i + 1}`}>
						<span class="ref-n">[{i + 1}]</span>
						<span>
							<a href={reference.url}>{reference.title}</a>.{" "}
							<span class="muted">{reference.source}.</span>
							{/* prettier-ignore */}
							{reference.extra?.map((link, j) => <>{j === 0 ? " " : ", "}<a class="ref-extra" href={link.url}>{link.name}</a></>)}
						</span>
					</li>
				))
			}
		</ol>
	</section>

	<section
		id="cite"
		class="appendix"
	>
		<h2 class="sec-title">Cite this page</h2>
		<div class="bibtex">
			<pre><code data-bibtex>{bibtex}</code></pre>
			<button
				type="button"
				class="copy-button"
				data-copy-bibtex
			>
				Copy BibTeX
			</button>
		</div>
	</section>
</PaperLayout>

<style>
	.writing-more {
		margin-top: 1.5rem;
	}

	.project-link {
		color: var(--ink);
		text-decoration: underline;
		text-decoration-color: var(--rule);
		text-underline-offset: 0.2em;
	}

	.project-link:hover {
		color: var(--prussian);
		text-decoration-color: currentColor;
	}
</style>
