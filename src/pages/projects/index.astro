---
import PageLayout from "../../layouts/PageLayout.astro";

const MONOLITH_POST =
	"/blog/coding-and-development/building-scalable-modular-monoliths-fastapi/";

type Link = { name: string; url: string };

type System = {
	id: string;
	name: string;
	summary: string;
	decisionsHeading: string;
	decisions: string[];
	builtWith: string;
	links: Link[];
};

const openSource: System[] = [
	{
		id: "fastapi-template",
		name: "FastAPI backend template",
		summary:
			"A production-ready FastAPI backend I built for Hybrid Interactive, published as the company's official open-source template. It's the starting point for many of our ERP and CRM backends.",
		decisionsHeading: "Design decisions",
		decisions: [
			"A modular monolith, split into modules by business domain following domain-driven design",
			"Async SQLAlchemy 2.0 for data access, with Alembic migrations",
			"JWT authentication with refresh tokens and role-based access control",
			"Celery for background jobs, monitored with Flower",
			"One storage interface for DigitalOcean Spaces and other S3-compatible services",
		],
		builtWith: "Python, FastAPI, SQLAlchemy, Celery, Docker",
		links: [
			{ name: "GitHub", url: "https://github.com/hybridinteract/fastapi-template" },
			{ name: "Why it's structured this way", url: MONOLITH_POST },
		],
	},
	{
		id: "fastapi-admin-cli",
		name: "fastapi-admin-cli",
		summary:
			"A Django-inspired command-line tool for FastAPI. It scaffolds projects with a clean modular structure and handles the routine work around them.",
		decisionsHeading: "What it does",
		decisions: [
			"Creates a structured FastAPI project with one command",
			"Generates new modular apps inside a project",
			"Builds and runs Docker containers, and opens a shell inside them",
			"Runs Alembic database migrations",
		],
		builtWith: "Python, Typer, Docker, Alembic",
		links: [
			{ name: "GitHub", url: "https://github.com/amal-babu-git/fastapi-admin-cli" },
			{ name: "Documentation", url: "https://amal-babu-git.github.io/fastapi-admin-cli-docs/" },
			{ name: "PyPI", url: "https://pypi.org/project/fastapi-admin-cli/" },
		],
	},
];

const earlier = [
	{
		name: "OnShop",
		summary:
			"An e-commerce platform for a hypermarket with an integrated payment gateway. Django and React, deployed on AWS EC2 with Docker and HTTPS through Certbot.",
		link: { name: "View demo", url: "https://onshopweb.web.app/" },
	},
	{
		name: "Food donation system",
		summary:
			"Connects food donors with NGOs to reduce food waste. Django REST Framework on the backend, React, Redux and Tailwind CSS on the frontend.",
		link: { name: "GitHub", url: "https://github.com/amal-babu-git/food-donation-system" },
	},
	{
		name: "CGPA and SGPA calculator",
		summary:
			"Helps VTU students calculate their SGPA and CGPA. Built for search visibility, and used by over 2,000 students.",
		link: { name: "Open the calculator", url: "https://cgpa-sgpa.web.app/" },
	},
];
---

<PageLayout
	title="Systems"
	description="Open-source tools by Amal Babu for structuring FastAPI backends, plus research and earlier projects."
>
	<header class="page-head">
		<h1 class="page-title font-display">Systems</h1>
		<p class="page-lead">
			Open-source tools for structuring FastAPI backends, my research, and
			the projects that came before them.
		</p>
	</header>

	<section
		class="band"
		aria-labelledby="open-source"
	>
		<h2
			id="open-source"
			class="band-name"
		>
			Open source
		</h2>
		<div class="systems">
			{
				openSource.map((system) => (
					<article
						id={system.id}
						class="system"
					>
						<h3 class="system-name font-display">{system.name}</h3>
						<p>{system.summary}</p>

						<h4 class="spec-heading">{system.decisionsHeading}</h4>
						<ul class="spec-list">
							{system.decisions.map((decision) => (
								<li>{decision}</li>
							))}
						</ul>

						<p class="built-with">
							<span class="muted">Built with</span> {system.builtWith}
						</p>

						<p class="link-row">
							{system.links.map((link) => (
								<a
									class="text-link"
									href={link.url}
								>
									{link.name}
								</a>
							))}
						</p>
					</article>
				))
			}
		</div>
	</section>

	<section
		class="band"
		aria-labelledby="research"
	>
		<h2
			id="research"
			class="band-name"
		>
			Research
		</h2>
		<article
			id="skimlit"
			class="system"
		>
			<h3 class="system-name font-display">SkimLit</h3>
			<p>
				An NLP model that classifies the sentences of medical abstracts into
				objectives, methods and conclusions. Published as a research paper in
				IJRAR.
			</p>
			<p class="built-with">
				<span class="muted">Built with</span> TensorFlow, scikit-learn, React,
				Docker
			</p>
			<p class="link-row">
				<a
					class="text-link"
					href="https://www.ijrar.org/papers/IJRAR1DUP049.pdf">Read the paper</a
				>
			</p>
		</article>
	</section>

	<section
		class="band"
		aria-labelledby="earlier"
	>
		<h2
			id="earlier"
			class="band-name"
		>
			Earlier projects
		</h2>
		<div>
			<ul class="earlier">
				{
					earlier.map((project) => (
						<li>
							<h3 class="earlier-name">{project.name}</h3>
							<p class="muted">{project.summary}</p>
							<a
								class="text-link"
								href={project.link.url}
							>
								{project.link.name}
							</a>
						</li>
					))
				}
			</ul>
			<p>
				Everything else is on
				<a
					class="text-link"
					href="https://github.com/amal-babu-git">GitHub</a
				>.
			</p>
		</div>
	</section>
</PageLayout>

<style>
	.page-head {
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--rule);
	}

	.systems {
		display: grid;
		gap: 3.5rem;
	}

	.system {
		scroll-margin-top: 2rem;
	}

	.system-name {
		font-size: 1.75rem;
		font-weight: 600;
		line-height: 1.2;
		margin: 0 0 0.75rem;
	}

	.spec-heading {
		font-size: 1.0625rem;
		font-weight: 600;
		margin: 1.5rem 0 0.5rem;
	}

	/* Small open squares: each decision is a component of the design. */
	.spec-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.spec-list li {
		position: relative;
		padding-left: 1.5rem;
		margin-bottom: 0.375rem;
	}

	.spec-list li::before {
		content: "";
		position: absolute;
		left: 0.125rem;
		top: 0.6em;
		width: 0.5rem;
		height: 0.5rem;
		border: 1.25px solid var(--ink);
		border-radius: 1px;
	}

	.built-with {
		margin-top: 1.25rem;
	}

	.system .link-row {
		margin-top: 0.75rem;
	}

	.earlier {
		list-style: none;
		margin: 0 0 2rem;
		padding: 0;
		display: grid;
		gap: 1.75rem;
	}

	.earlier-name {
		font-size: 1.0625rem;
		font-weight: 600;
		margin: 0 0 0.25rem;
	}

	.earlier .muted {
		margin-bottom: 0.25rem;
	}
</style>
