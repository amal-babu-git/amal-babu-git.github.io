---
import BaseLayout from "../../layouts/SimpleLayout.astro";

const projects = [
  {
    name: "FastAPI Admin CLI",
    description: "A Django-inspired CLI tool for managing FastAPI applications with a modular structure. This tool helps developers quickly scaffold and manage FastAPI projects with a clean, organized architecture.",
    tags: ["Python", "FastAPI", "CLI", "Docker"],
    links: [
      {
        name: "GitHub",
        url: "https://github.com/amal-babu-git/fastapi-admin-cli",
        icon: {
          viewBox: "0 0 24 24",
          path: "M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
        }
      },
      {
        name: "Documentation",
        url: "https://amal-babu-git.github.io/fastapi-admin-cli-docs/",
        icon: {
          viewBox: "0 0 24 24",
          path: "M19 2c1.654 0 3 1.346 3 3v14c0 1.654-1.346 3-3 3h-14c-1.654 0-3-1.346-3-3v-14c0-1.654 1.346-3 3-3h14zm0-2h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-7 13v-6h-2v6h-3l4 4 4-4h-3zm-4-12h8v2h-8v-2z"
        }
      },
      {
        name: "PyPI",
        url: "https://pypi.org/project/fastapi-admin-cli/",
        icon: {
          viewBox: "0 0 24 24",
          path: "M11.95 3c-4.4 0-7.95 3.58-7.95 8s3.55 8 7.95 8 7.95-3.58 7.95-8-3.55-8-7.95-8zm-6.06 8c0-3.36 2.72-6.09 6.06-6.09s6.06 2.73 6.06 6.09-2.72 6.1-6.06 6.1-6.06-2.74-6.06-6.1zm3.09-3.2c-.88 0-1.6.72-1.6 1.61 0 .89.72 1.61 1.6 1.61.89 0 1.61-.72 1.61-1.61 0-.89-.72-1.61-1.61-1.61zm5.95 0c-.89 0-1.61.72-1.61 1.61 0 .89.72 1.61 1.61 1.61.88 0 1.6-.72 1.6-1.61 0-.89-.72-1.61-1.6-1.61z"
        }
      }
    ],
    features: [
      "Project Scaffolding: Create well-structured FastAPI projects with a single command",
      "App Management: Generate modular apps within your project",
      "Docker Integration: Built-in Docker support with commands for building and running containers",
      "Database Migrations: Easy database migration commands using Alembic",
      "Developer Tools: Shell access to Docker containers and more"
    ],
   
    image: "/images/projects/fastapi-admin-cli.png" // Add an appropriate image path
  }
  // Add more projects here in the future
];
---

<BaseLayout title="Open Source Projects" description= "">
  <div class="flex flex-col gap-8">
    <header>
      <h1 class="text-3xl font-bold mb-2">Open Source Projects</h1>
      <p class="text-base-content/80">
        Explore my open source projects and contributions. These projects are developed with a focus on
        solving real-world problems and providing valuable tools for the developer community.
      </p>
    </header>

    <div class="divider"></div>
    
    <!-- Projects Grid -->
    <div class="flex flex-col gap-16">
      {projects.map((project, index) => (
        <div class="project-card">
          <div class="flex flex-col gap-8">
            <!-- Project Info Section -->
            <div>
              <h2 class="text-2xl font-bold mb-3">{project.name}</h2>
              
              <p class="mb-4">{project.description}</p>
              
              <div class="flex flex-wrap gap-2 mb-6">
                {project.tags.map(tag => (
                  <div class="badge badge-outline">{tag}</div>
                ))}
              </div>
              
              <div class="flex flex-wrap gap-3 mb-6">
                {project.links.map(link => (
                  <a 
                    href={link.url} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="btn btn-sm btn-outline gap-1"
                  >
                    <svg 
                      xmlns="http://www.w3.org/2000/svg" 
                      viewBox={link.icon.viewBox}
                      class="w-4 h-4 fill-current"
                      aria-hidden="true"
                    >
                      <path d={link.icon.path}></path>
                    </svg>
                    {link.name}
                  </a>
                ))}
              </div>
              
              <!-- Key Features -->
              <div class="mb-6">
                <h3 class="font-semibold text-lg mb-2">Key Features</h3>
                <ul class="space-y-1 list-inside">
                  {project.features.map(feature => (
                    <li class="flex gap-2 items-start">
                      <span>•</span>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
            
            <!-- Project Details Section -->
            
          </div>
          
          {index < projects.length - 1 && <div class="divider mt-8"></div>}
        </div>
      ))}
    </div>
    
    <!-- Future Projects Section -->
    <div class="mt-8 text-center">
      <h2 class="text-xl font-bold mb-6">More Projects Coming Soon</h2>
      <p class="max-w-2xl mx-auto">
        I'm constantly working on new open source projects and improvements to existing ones.
        Check back soon or follow me on GitHub to stay updated on my latest work.
      </p>
      
      <a 
        href="https://github.com/amal-babu-git" 
        target="_blank" 
        rel="noopener noreferrer"
        class="btn btn-outline mt-4"
      >
        <svg 
          xmlns="http://www.w3.org/2000/svg" 
          viewBox="0 0 24 24"
          class="w-5 h-5 mr-2 fill-current"
          aria-hidden="true"
        >
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
        </svg>
        Follow on GitHub
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  /* Add any specific styles you need here */
  .project-card {
    transition: transform 0.2s ease-in-out;
  }
  
  @media (min-width: 768px) {
    .project-card:hover {
      transform: translateY(-4px);
    }
  }
</style>
