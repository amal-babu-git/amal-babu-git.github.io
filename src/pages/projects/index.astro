---
import PageLayout from "../../layouts/PageLayout.astro";

const MONOLITH_POST =
	"/blog/coding-and-development/building-scalable-modular-monoliths-fastapi/";

type Link = { name: string; url: string };

type System = {
	id: string;
	name: string;
	summary: string;
	decisionsHeading: string;
	decisions: string[];
	builtWith: string;
	links: Link[];
};

const openSource: System[] = [
	{
		id: "fastapi-template",
		name: "FastAPI backend template",
		summary:
			"A production-ready FastAPI backend I built for Hybrid Interactive, published as the company's official open-source template. It's the starting point for many of our ERP and CRM backends.",
		decisionsHeading: "Design decisions",
		decisions: [
			"A modular monolith, split into modules by business domain following domain-driven design",
			"Async SQLAlchemy 2.0 for data access, with Alembic migrations",
			"JWT authentication with refresh tokens and role-based access control",
			"Celery for background jobs, monitored with Flower",
			"One storage interface for DigitalOcean Spaces and other S3-compatible services",
		],
		builtWith: "Python, FastAPI, SQLAlchemy, Celery, Docker",
		links: [
			{ name: "GitHub", url: "https://github.com/hybridinteract/fastapi-template" },
			{ name: "Why it's structured this way", url: MONOLITH_POST },
		],
	},
	{
		id: "deployctl",
		name: "deployctl",
		summary:
			"A deployment tool I built for Hybrid Interactive, now open source. It takes a containerized app to one server, or to several behind a load balancer, and needs nothing on the servers but Docker and SSH. Once a project is set up, a release is a merge: GitHub Actions runs deployctl on every push to the deploy branch. The same commands work from a laptop, and a local control panel takes a new project through its first deployment.",
		decisionsHeading: "Design decisions",
		decisions: [
			"Nothing is built on a server. CI builds the image and pushes it to a registry, and hosts pull one immutable tag, which is also what makes a rollback possible",
			"Rolling deploys, primary first, with each host gated on a health check and a watch on every service. If a host fails, it and every host already updated go back to the previous release, so the fleet is never left split between two",
			"A single server is a cluster of one. Both share one code path and differ only in the number of hosts, where TLS ends, and whether Postgres and Redis run in containers",
			"Migrations run once, on the primary, before any app container restarts, and the scheduler runs on exactly one host so no job fires twice",
			"One lock per environment, shared by CI and laptops, so two deploys can never interleave",
			"The control panel listens on 127.0.0.1 only, can trigger nothing outside a fixed list of actions, and shows the exact command behind every button",
		],
		builtWith: "Python, Typer, FastAPI, Jinja2, Bash, Docker Compose, GitHub Actions",
		links: [
			{ name: "GitHub", url: "https://github.com/hybridinteract/deployctl" },
			{ name: "Documentation", url: "https://github.com/hybridinteract/deployctl/tree/main/docs" },
		],
	},
];

---

<PageLayout
	title="Systems"
	description="Open-source tools by Amal Babu for starting and deploying backends."
>
	<header class="page-head">
		<h1 class="page-title font-display">Systems</h1>
		<p class="page-lead">
			Open-source tools for starting and deploying backends.
		</p>
	</header>

	<section
		class="band"
		aria-labelledby="open-source"
	>
		<h2
			id="open-source"
			class="band-name"
		>
			Open source
		</h2>
		<div class="systems">
			{
				openSource.map((system) => (
					<article
						id={system.id}
						class="system"
					>
						<h3 class="system-name font-display">{system.name}</h3>
						<p>{system.summary}</p>

						<h4 class="spec-heading">{system.decisionsHeading}</h4>
						<ul class="spec-list">
							{system.decisions.map((decision) => (
								<li>{decision}</li>
							))}
						</ul>

						<p class="built-with">
							<span class="muted">Built with</span> {system.builtWith}
						</p>

						<p class="link-row">
							{system.links.map((link) => (
								<a
									class="text-link"
									href={link.url}
								>
									{link.name}
								</a>
							))}
						</p>
					</article>
				))
			}
		</div>
	</section>
</PageLayout>

<style>
	.page-head {
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--rule);
	}

	.systems {
		display: grid;
		gap: 3.5rem;
	}

	.system {
		scroll-margin-top: 2rem;
	}

	.system-name {
		font-size: 1.75rem;
		font-weight: 600;
		line-height: 1.2;
		margin: 0 0 0.75rem;
	}

	.spec-heading {
		font-size: 1.0625rem;
		font-weight: 600;
		margin: 1.5rem 0 0.5rem;
	}

	/* Small open squares: each decision is a component of the design. */
	.spec-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.spec-list li {
		position: relative;
		padding-left: 1.5rem;
		margin-bottom: 0.375rem;
	}

	.spec-list li::before {
		content: "";
		position: absolute;
		left: 0.125rem;
		top: 0.6em;
		width: 0.5rem;
		height: 0.5rem;
		border: 1.25px solid var(--ink);
		border-radius: 1px;
	}

	.built-with {
		margin-top: 1.25rem;
	}

	.system .link-row {
		margin-top: 0.75rem;
	}

</style>
