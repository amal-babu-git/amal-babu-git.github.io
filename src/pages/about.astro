---
import PageLayout from "../layouts/PageLayout.astro";
import CareerTrace from "../components/CareerTrace.astro";
import GitHubActivity from "../components/GitHubActivity.astro";
import { SOCIAL_LINKS, RESUME_URL } from "../consts";

const roles = [
	{
		title: "Full-Stack Developer and Tech Lead",
		org: "Hybrid Interactive Consultancy, Kochi",
		dates: "May 2025 – present",
		current: true,
		points: [
			"Build business software for clients in healthcare, construction, e-commerce and influencer marketing, including ERP and CRM modules for accounting, HR, hospital management, pharmacy and inventory.",
			"Technical lead on each client project: lead the project and its system design, direct the team and make the key technical decisions.",
			"Lead a small team of developers, coordinating delivery and keeping code quality high.",
			"Built the company's open-source FastAPI backend template, the starting point for many of our backends, and deployctl, the tool we deploy them with.",
			"Integrate AI into business software where it does useful work, building agents and automation into ERP, CRM and web applications.",
			"Practice agentic engineering: using GitHub Copilot and Claude Code with engineering judgment and human review to deliver faster.",
		],
		stack: "Next.js, React, Astro, Django, DRF, FastAPI, Appwrite, PostgreSQL",
	},
	{
		title: "Full-Stack Developer Intern",
		org: "Easecase AI",
		dates: "Nov 2023 – Jun 2024",
		current: false,
		points: [
			"Built a web-based document analysis tool for lawyers with Flask, React and MongoDB.",
			"Added AI document summarization using the GPT-4 API.",
		],
	},
	{
		title: "Cybersecurity Intern",
		org: "Samagra Technologies",
		dates: "Dec 2023 – Jan 2024",
		current: false,
		points: [
			"Ran network security tasks, including risk assessments and vulnerability analysis.",
			"Worked hands-on with web application security, firewalls and VPN configuration.",
		],
	},
];

const skills = [
	["Architecture", "System design, technical architecture, requirements gathering, team leadership"],
	["Backend", "FastAPI, Django, Django REST Framework, Flask, Celery, Redis"],
	["Frontend", "React, Next.js, Astro, Redux, Tailwind CSS, HTML, CSS"],
	["Data", "PostgreSQL, MySQL, MongoDB, SQLAlchemy"],
	["AI", "Pydantic AI, LangGraph, RAG pipelines, generative AI, NLP, scikit-learn, pandas, NumPy, ComfyUI"],
	["Agentic engineering", "Claude Code, GitHub Copilot, OpenAI Codex"],
	["Languages", "Python, JavaScript, SQL, C++, Java"],
	["Cloud and tools", "Docker, Git, GitHub, AWS, Microsoft Azure, DigitalOcean"],
	["Domains", "Healthcare, construction, e-commerce, influencer marketing"],
	["ERP and CRM modules", "Accounting, HR, hospital management, pharmacy, inventory"],
];

const education = [
	{
		degree: "Master of Computer Applications",
		school: "Srinivas Institute of Technology (VTU)",
		year: "2024",
		grade: "CGPA 8.9",
	},
	{
		degree: "Bachelor of Computer Applications",
		school: "St. Philomena College",
		year: "2022",
		grade: "CGPA 8.34",
	},
];

// Built as part of my degrees, not professional work; listed here only.
const collegeProjects = [
	{
		name: "OnShop",
		summary:
			"An e-commerce site for a hypermarket with a payment gateway. Django and React, deployed on AWS EC2 with Docker.",
		link: { name: "Demo", url: "https://onshopweb.web.app/" },
	},
	{
		name: "Food donation system",
		summary:
			"Connects food donors with NGOs. Django REST Framework, React, Redux and Tailwind CSS.",
		link: { name: "GitHub", url: "https://github.com/amal-babu-git/food-donation-system" },
	},
	{
		name: "CGPA and SGPA calculator",
		summary: "A grade calculator for VTU students, used by over 2,000 of them.",
		link: { name: "Open it", url: "https://cgpa-sgpa.web.app/" },
	},
	{
		name: "SkimLit",
		summary:
			"An NLP model that labels the sentences of medical abstracts as objectives, methods and conclusions, written up in IJRAR.",
		link: { name: "Paper", url: "https://www.ijrar.org/papers/IJRAR1DUP049.pdf" },
	},
];

const certifications = [
	{
		name: "Microsoft Certified: Azure Fundamentals (AZ-900)",
		url: "https://www.credly.com/badges/e6115f54-1354-4f71-a0a7-07615762b6fd/linked_in_profile",
	},
	{
		name: "Machine Learning Specialization, DeepLearning.AI (Coursera)",
		url: "https://www.coursera.org/account/accomplishments/specialization/HYGYCXYPBVND",
	},
	{
		name: "Google Cloud Computing Foundations (NPTEL)",
		url: "https://archive.nptel.ac.in/content/noc/NOC23/SEM2/Ecertificates/106/noc23-cs90/Course/NPTEL23CS90S84140058020285070.pdf",
	},
	{
		name: "Mathematics for Machine Learning, Imperial College London (Coursera)",
		url: "https://www.coursera.org/account/accomplishments/specialization/23Q6S6A6VZRL",
	},
];
---

<PageLayout
	title="About"
	description="Work history, skills, education and certifications of Amal Babu, a full-stack developer and tech lead building business software in Kochi, India."
>
	<header class="page-head">
		<h1 class="page-title font-display">About</h1>
		<div class="about-intro">
			<p class="page-lead">
				I'm a full-stack software developer and tech lead. I build the software
				businesses run on, with AI built in.
			</p>
			<p>
				At Hybrid Interactive in Kochi, I lead a small team building software
				for clients in healthcare, construction, e-commerce and influencer
				marketing, including ERP and CRM systems for accounting, HR, hospital
				management, pharmacy and inventory. I handle it end to end, from
				gathering requirements to system architecture and delivery. The systems
				I've led are on the <a
					class="text-link"
					href="/client-projects">Client projects page</a
				>, and the <a
					class="text-link"
					href="/">homepage</a
				> sets out how I structure them.
			</p>
			<p>
				On the AI side, I build agents and automation with Pydantic AI and
				LangGraph, and integrate them directly into business software. I also
				practice agentic engineering: working with Claude Code, GitHub Copilot
				and OpenAI Codex, with engineering judgment and human review, to ship
				faster without lowering the bar on code quality.
			</p>
			<p>
				My stack is Python, FastAPI and Django on the backend; React, Next.js
				and Tailwind CSS on the frontend; PostgreSQL and SQLAlchemy for data;
				and a grounding in system design and architecture.
			</p>
			<p class="link-row">
				<a
					class="text-link"
					href={RESUME_URL}>View résumé</a
				>
				<a
					class="text-link"
					href={`mailto:${SOCIAL_LINKS.email}`}>Email me</a
				>
			</p>
		</div>
	</header>

	<section
		id="experience"
		class="band"
		aria-labelledby="work"
	>
		<h2
			id="work"
			class="band-name"
		>
			Work
		</h2>
		<div>
			<CareerTrace />
		<ol class="roles">
			{
				roles.map((role) => (
					<li class:list={["role", { "is-current": role.current }]}>
						<p class="role-dates">{role.dates}</p>
						<h3 class="role-title">{role.title}</h3>
						<p class="role-org">{role.org}</p>
						<ul class="role-points">
							{role.points.map((point) => (
								<li>{point}</li>
							))}
						</ul>
						{role.stack && (
							<p class="role-stack">
								<span class="muted">Stack</span> {role.stack}
							</p>
						)}
					</li>
				))
			}
		</ol>
		</div>
	</section>

	<section
		id="github"
		class="band"
		aria-labelledby="github-heading"
	>
		<h2
			id="github-heading"
			class="band-name"
		>
			GitHub
		</h2>
		<GitHubActivity />
	</section>

	<section
		id="skills"
		class="band"
		aria-labelledby="skills-heading"
	>
		<h2
			id="skills-heading"
			class="band-name"
		>
			Skills
		</h2>
		<dl class="skills">
			{
				skills.map(([area, items]) => (
					<div>
						<dt>{area}</dt>
						<dd>{items}</dd>
					</div>
				))
			}
		</dl>
	</section>

	<section
		id="education"
		class="band"
		aria-labelledby="education-heading"
	>
		<h2
			id="education-heading"
			class="band-name"
		>
			Education
		</h2>
		<ul class="plain-list">
			{
				education.map((item) => (
					<li>
						<h3 class="item-title">{item.degree}, {item.year}</h3>
						<p class="muted">
							{item.school}. {item.grade}
						</p>
					</li>
				))
			}
		</ul>
	</section>

	<section
		id="certifications"
		class="band"
		aria-labelledby="certifications-heading"
	>
		<h2
			id="certifications-heading"
			class="band-name"
		>
			Certifications
		</h2>
		<ul class="plain-list">
			{
				certifications.map((cert) => (
					<li>
						<a
							class="text-link"
							href={cert.url}
						>
							{cert.name}
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section
		id="projects"
		class="band"
		aria-labelledby="projects-heading"
	>
		<h2
			id="projects-heading"
			class="band-name"
		>
			College projects
		</h2>
		<div>
			<p class="muted college-note">
				Built as part of my BCA and MCA degrees. My open-source tools are on the <a
					class="text-link"
					href="/projects">Systems page</a
				>.
			</p>
			<ul class="plain-list">
				{
					collegeProjects.map((project) => (
						<li>
							<h3 class="item-title">{project.name}</h3>
							<p class="muted">
								{project.summary}{" "}
								<a
									class="text-link"
									href={project.link.url}
								>
									{project.link.name}
								</a>
							</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section
		id="connect"
		class="band"
		aria-labelledby="contact-heading"
	>
		<h2
			id="contact-heading"
			class="band-name"
		>
			Contact
		</h2>
		<div>
			<p>
				Based in Kochi, India. Email is the quickest way to reach me:
				<a
					class="text-link"
					href={`mailto:${SOCIAL_LINKS.email}`}>{SOCIAL_LINKS.email}</a
				>
			</p>
			<p class="link-row contact-links">
				<a
					class="text-link"
					href={SOCIAL_LINKS.linkedin}>LinkedIn</a
				>
				<a
					class="text-link"
					href={SOCIAL_LINKS.github}>GitHub</a
				>
				<a
					class="text-link"
					href={SOCIAL_LINKS.leetcode}>LeetCode</a
				>
				<a
					class="text-link"
					href={SOCIAL_LINKS.medium}>Medium</a
				>
			</p>
		</div>
	</section>
</PageLayout>

<style>
	.page-head {
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--rule);
	}

	.about-intro {
		max-width: 44rem;
	}

	.about-intro p + p {
		margin-top: 1rem;
	}

	.about-intro .link-row {
		margin-top: 1.5rem;
	}

	.band {
		scroll-margin-top: 1rem;
	}

	/* Work history is a real sequence, so it gets a timeline.
	   A filled marker means the role is current. */
	.roles {
		list-style: none;
		margin: 0;
		padding: 0;
		border-left: 1px solid var(--rule);
	}

	.role {
		position: relative;
		padding-left: 1.75rem;
		padding-bottom: 2.5rem;
	}

	.role:last-child {
		padding-bottom: 0;
	}

	.role::before {
		content: "";
		position: absolute;
		left: -0.3125rem;
		top: 0.45em;
		width: 0.625rem;
		height: 0.625rem;
		background: var(--film);
		border: 1.25px solid var(--ink);
		border-radius: 1px;
	}

	.role.is-current::before {
		background: var(--ink);
	}

	.role-dates {
		color: var(--graphite);
		font-variant-numeric: tabular-nums;
	}

	.role-title {
		font-family: var(--font-heading);
		font-stretch: 118%;
		font-size: 1.3125rem;
		font-weight: 600;
		line-height: 1.3;
		margin: 0.125rem 0 0;
	}

	.role-org {
		color: var(--graphite);
		margin-bottom: 0.75rem;
	}

	.role-points {
		list-style: disc;
		padding-left: 1.125rem;
		margin: 0;
	}

	.role-points li {
		margin-bottom: 0.375rem;
	}

	.role-points li::marker {
		color: var(--graphite);
	}

	.role-stack {
		margin-top: 0.75rem;
	}

	.skills {
		display: grid;
		gap: 0.875rem;
		margin: 0;
	}

	.skills div {
		display: grid;
		gap: 0.125rem;
	}

	@media (min-width: 560px) {
		.skills div {
			grid-template-columns: 11rem minmax(0, 1fr);
			column-gap: 1.5rem;
		}
	}

	.skills dt {
		color: var(--graphite);
	}

	.skills dd {
		margin: 0;
	}

	.plain-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1rem;
	}

	.item-title {
		font-size: 1.0625rem;
		font-weight: 600;
		margin: 0;
	}

	.college-note {
		margin-bottom: 1.25rem;
	}

	.contact-links {
		margin-top: 0.75rem;
	}
</style>
