---
// One topic of the writing index, in the same paper style.
import PaperLayout, { type ContentsItem } from "../../../layouts/PaperLayout.astro";
import WritingEntry from "../../../components/paper/WritingEntry.astro";
import { getCollection } from "astro:content";
import { byNewest, fullDate, groupByTopic } from "../../../utils/writing";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return groupByTopic(posts)
		.filter((topic) => topic.slug !== "writing")
		.map((topic) => ({
			params: { subcategory: topic.slug },
			props: { label: topic.label, posts: topic.posts.sort(byNewest) },
		}));
}

const { label, posts } = Astro.props;
const latest = posts[0];

const contents: ContentsItem[] = [
	{ id: "articles", n: "1", label: "Articles" },
	{ id: "all-writing", label: "All writing" },
];
---

<PaperLayout
	title={`${label} articles`}
	description={`Articles by Amal Babu on ${label.toLowerCase()}.`}
	contents={contents}
>
	<header
		slot="front"
		class="front"
	>
		<h1 class="paper-title font-display">{label}</h1>
		<p class="paper-subtitle">
			Articles on {label.toLowerCase()}, newest first
		</p>
		<dl class="byline">
			<div>
				<dt>Articles</dt>
				<dd>{posts.length}</dd>
			</div>
			{
				latest && (
					<div>
						<dt>Latest</dt>
						<dd>
							<time datetime={latest.data.pubDate.toISOString()}>
								{fullDate(latest.data.pubDate)}
							</time>
						</dd>
					</div>
				)
			}
			<div>
				<dt>Index</dt>
				<dd><a href="/blog">All writing</a></dd>
			</div>
		</dl>
	</header>

	<section
		id="articles"
		class="abstract"
	>
		<h2 class="sec-title">
			<span class="sec-n">1</span>Articles
		</h2>
		{
			posts.map((post, i) => (
				<WritingEntry
					post={post}
					n={`1.${i + 1}`}
				/>
			))
		}
	</section>

	<section
		id="all-writing"
		class="statement"
	>
		<h2 class="sec-title">All writing</h2>
		<p>
			Every topic is on the <a
				class="text-link"
				href="/blog">Writing page</a
			>. New articles appear in the <a
				class="text-link"
				href="/rss.xml">RSS feed</a
			>.
		</p>
	</section>
</PaperLayout>
