---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Get featured posts (first 3)
const featuredPosts = posts.slice(0, 3);
// Get remaining posts
const remainingPosts = posts.slice(3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="container mx-auto px-4 py-8">
			<!-- Page Title with Filter Options -->
			<div class="flex flex-col md:flex-row md:items-center md:justify-between mb-8 gap-4">
				<h1 class="text-4xl font-bold">Explorations</h1>
				
				<div class="join">
					<button class="join-item btn btn-sm">All</button>
					<button class="join-item btn btn-sm btn-ghost">Recent</button>
					<button class="join-item btn btn-sm btn-ghost">Popular</button>
				</div>
			</div>

			<!-- Featured Showcase - Horizontal Scroll on Mobile -->
			{featuredPosts.length > 0 && (
				<div class="mb-12">
					<h2 class="text-lg font-medium mb-4 text-base-content/70">Featured Stories</h2>
					<div class="carousel w-full rounded-box">
						{featuredPosts.map((post, index) => (
							<div id={`slide-${index}`} class="carousel-item relative w-full md:w-4/5 lg:w-2/3">
								<div class="hero min-h-[60vh] bg-base-200 relative overflow-hidden rounded-xl">
									<img 
										src={post.data.heroImage} 
										alt="" 
										class="absolute inset-0 w-full h-full object-cover mix-blend-overlay opacity-60"
									/>
									<div class="hero-overlay bg-gradient-to-t from-base-300 to-transparent"></div>
									<div class="hero-content text-left p-6 md:p-10 relative z-10 w-full">
										<div class="max-w-md md:max-w-2xl">
											<div class="badge badge-primary mb-4">Featured</div>
											<h2 class="text-3xl md:text-4xl font-bold mb-2">{post.data.title}</h2>
											<p class="text-base-content/70 mb-4">
												<FormattedDate date={post.data.pubDate} />
											</p>
											<p class="mb-6 line-clamp-2 md:line-clamp-3">{post.data.description}</p>
											<a href={`/blog/${post.id}/`} class="btn btn-primary">Read Article</a>
										</div>
									</div>
								</div>
								<div class="absolute flex justify-between transform -translate-y-1/2 left-5 right-5 top-1/2">
									<a href={`#slide-${index === 0 ? featuredPosts.length - 1 : index - 1}`} class="btn btn-circle btn-ghost">❮</a> 
									<a href={`#slide-${index === featuredPosts.length - 1 ? 0 : index + 1}`} class="btn btn-circle btn-ghost">❯</a>
								</div>
							</div>
						))}
					</div>
					
					<div class="flex justify-center w-full py-2 gap-2 mt-2">
						{featuredPosts.map((_, index) => (
							<a href={`#slide-${index}`} class="btn btn-xs btn-circle">{index + 1}</a>
						))}
					</div>
				</div>
			)}

			<!-- Staggered Post Layout -->
			<div class="mb-12">
				<h2 class="text-lg font-medium mb-4 text-base-content/70">All Articles</h2>
				
				<div class="grid grid-cols-1 md:grid-cols-6 gap-6">
					{remainingPosts.map((post, index) => {
						// Determine column span for asymmetric layout
						const spanClasses = [
							"md:col-span-6", // Full width first item
							"md:col-span-3", // Half width for some items
							"md:col-span-3",
							"md:col-span-2", // Smaller items
							"md:col-span-2",
							"md:col-span-2",
							"md:col-span-4", // Wider item
							"md:col-span-2",
							"md:col-span-3",
							"md:col-span-3",
						];
						
						// Get the span class or default to col-span-3 if beyond our pattern
						const span = spanClasses[index % spanClasses.length] || "md:col-span-3";
						
						// Alternative styles
						const isAlternative = index % 3 === 1;
						const isCompact = index % 5 === 0;
						
						return (
							<div class={`group ${span}`}>
								{isAlternative ? (
									// Alternative horizontal card layout
									<div class="card card-side bg-base-100 shadow-md hover:shadow-xl transition-all duration-300 h-full">
										<figure class="w-1/3">
											<img src={post.data.heroImage} alt="" class="h-full w-full object-cover" />
										</figure>
										<div class="card-body p-4">
											<h2 class="card-title text-base group-hover:text-primary transition-colors">{post.data.title}</h2>
											<p class="text-xs text-base-content/60 mb-1">
												<FormattedDate date={post.data.pubDate} />
											</p>
											<div class="card-actions justify-end mt-auto">
												<a href={`/blog/${post.id}/`} class="btn btn-sm btn-ghost btn-circle">
													<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
														<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
													</svg>
												</a>
											</div>
										</div>
									</div>
								) : isCompact ? (
									// Compact card variant
									<div class="border-l-4 border-primary pl-4 py-2 hover:bg-base-200 transition-colors duration-300">
										<h2 class="font-bold group-hover:text-primary transition-colors">{post.data.title}</h2>
										<p class="text-xs text-base-content/60 mt-1">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<a href={`/blog/${post.id}/`} class="mt-2 inline-flex items-center text-sm link link-primary">
											Read more 
											<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
											</svg>
										</a>
									</div>
								) : (
									// Default card with fancy hover effect
									<div class="card bg-base-100 shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden h-full group/card">
										<figure class="relative overflow-hidden h-48">
											<img 
												src={post.data.heroImage} 
												alt="" 
												class="w-full h-full object-cover transform group-hover/card:scale-110 transition-transform duration-700" 
											/>
											<div class="absolute inset-0 bg-gradient-to-t from-base-300/80 to-transparent"></div>
										</figure>
										<div class="card-body p-5">
											<h2 class="card-title group-hover:text-primary transition-colors">{post.data.title}</h2>
											<p class="text-sm text-base-content/70">
												<FormattedDate date={post.data.pubDate} />
											</p>
											<p class="text-sm line-clamp-2">{post.data.description}</p>
											<div class="card-actions justify-end mt-4">
												<a href={`/blog/${post.id}/`} class="btn btn-sm btn-outline btn-primary">Read Post</a>
											</div>
										</div>
									</div>
								)}
							</div>
						);
					})}
				</div>
			</div>
			
			<!-- Newsletter Signup -->
			<div class="card bg-primary text-primary-content p-8 my-12 relative overflow-hidden">
				<div class="absolute -bottom-6 -right-6 opacity-20">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-40 h-40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
					</svg>
				</div>
				<div class="max-w-xl mr-auto relative z-10">
					<h3 class="text-2xl font-bold mb-4">Subscribe to our newsletter</h3>
					<p class="mb-6">Get the latest posts delivered right to your inbox</p>
					<div class="flex flex-col sm:flex-row gap-2">
						<input type="email" placeholder="your@email.com" class="input w-full bg-primary-content/20 text-primary-content placeholder:text-primary-content/60" />
						<button class="btn bg-primary-content text-primary">Subscribe</button>
					</div>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
