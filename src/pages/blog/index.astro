---
// The writing index, set as a paper's table of contents: one numbered
// section per topic, each article with its abstract and drawing.
import PaperLayout, { type ContentsItem } from "../../layouts/PaperLayout.astro";
import WritingEntry from "../../components/paper/WritingEntry.astro";
import { getCollection } from "astro:content";
import { SOCIAL_LINKS } from "../../consts";
import { byNewest, fullDate, groupByTopic } from "../../utils/writing";

const posts = (await getCollection("blog")).sort(byNewest);
const topics = groupByTopic(posts);
const latest = posts[0];

const contents: ContentsItem[] = [
	{ id: "abstract", label: "About this index" },
	...topics.map((topic, i) => ({ id: `topic-${topic.slug}`, n: String(i + 1), label: topic.label })),
	{ id: "subscribe", label: "Subscribe" },
];
---

<PaperLayout
	title="Writing"
	description="Articles by Amal Babu on software architecture, system design and problem solving."
	contents={contents}
>
	<header
		slot="front"
		class="front"
	>
		<h1 class="paper-title font-display">Writing</h1>
		<p class="paper-subtitle">
			Notes on architecture, system design and the problems that changed how I
			build software
		</p>
		<dl class="byline">
			<div>
				<dt>Articles</dt>
				<dd>{posts.length}</dd>
			</div>
			<div>
				<dt>Topics</dt>
				<dd>{topics.length}</dd>
			</div>
			{
				latest && (
					<div>
						<dt>Latest</dt>
						<dd>
							<time datetime={latest.data.pubDate.toISOString()}>
								{fullDate(latest.data.pubDate)}
							</time>
						</dd>
					</div>
				)
			}
			<div>
				<dt>Feed</dt>
				<dd><a href="/rss.xml">RSS</a></dd>
			</div>
		</dl>
	</header>

	<section
		id="abstract"
		class="abstract"
	>
		<p>
			<strong>About this index.</strong> Long-form pieces argue for structure
			first; shorter notes work through one problem each. Articles are grouped
			by topic, newest first, each with its abstract and a drawing of the example
			it works through.
		</p>
	</section>

	{
		topics.map((topic, i) => (
			<section id={`topic-${topic.slug}`}>
				<h2 class="sec-title">
					<span class="sec-n">{i + 1}</span>{topic.label}
				</h2>
				{topic.posts.map((post, j) => (
					<WritingEntry
						post={post}
						n={`${i + 1}.${j + 1}`}
					/>
				))}
			</section>
		))
	}

	<section
		id="subscribe"
		class="statement"
	>
		<h2 class="sec-title">Subscribe</h2>
		<p>
			New articles appear in the <a
				class="text-link"
				href="/rss.xml">RSS feed</a
			>. Corrections and questions are welcome by <a
				class="text-link"
				href={`mailto:${SOCIAL_LINKS.email}`}>email</a
			>.
		</p>
	</section>
</PaperLayout>
