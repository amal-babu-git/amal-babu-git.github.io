---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Extract subcategories from file paths
const subcategories = [...new Set(
	posts.map(post => {
		// Extract directory name from id (e.g., "ai-ml/post1" -> "ai-ml")
		const pathParts = post.id.split('/');
		return pathParts.length > 1 ? pathParts[0] : null;
	}).filter(Boolean) // Remove null values
)] as string[];

// Format subcategory for display
const formatSubcategory = (subcategory: string) => {
	return subcategory
		.split('-')
		.map(word => word.charAt(0).toUpperCase() + word.slice(1))
		.join(' ');
};

// Get posts by subcategory
const getPostsBySubcategory = (subcategory: string) => {
	return posts.filter(post => post.id.startsWith(subcategory + '/'));
};

// Get featured posts (first 3)
const featuredPosts = posts.slice(0, 3);
const default_img = '../../../public/thumbnail.png'; // Replace with your default thumbnail URL
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="container mx-auto px-4 py-12 max-w-5xl">
			<!-- Featured posts section -->
			<section class="mb-20">
				<h2 class="text-3xl font-semibold mb-8 border-b border-base-300 pb-2">Featured Articles</h2>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
					{featuredPosts.map(post => (
						<article class="card bg-base-100 border border-base-200 hover:shadow-md transition-shadow duration-300 h-full">
							<figure class="h-52 overflow-hidden">
								<img 
									src={post.data.heroImage || default_img} 
									alt={post.data.title || "Blog post thumbnail"} 
									class="w-full h-full object-cover" 
								/>
							</figure>
							<div class="card-body p-6">
								<div class="text-xs font-medium text-base-content/70 mb-2">
									<FormattedDate date={post.data.pubDate} />
								</div>
								<h3 class="text-xl font-semibold mb-2 line-clamp-2">{post.data.title}</h3>
								<p class="text-sm mb-4 line-clamp-3 text-base-content/80">{post.data.description}</p>
								<div class="card-actions mt-auto">
									<a href={`/blog/${post.id}/`} class="btn btn-sm btn-ghost normal-case">
										Read More →
									</a>
								</div>
							</div>
						</article>
					))}
				</div>
			</section>
			
			<!-- Subcategory sections -->
			{subcategories.map(subcategory => (
				<section class="mb-20">
					<div class="flex justify-between items-center mb-8 border-b border-base-300 pb-2">
						<h2 class="text-3xl font-semibold">{formatSubcategory(subcategory)}</h2>
						{getPostsBySubcategory(subcategory).length > 3 && (
							<a href={`/blog/category/${subcategory}`} class="text-sm font-medium hover:underline">
								View all articles →
							</a>
						)}
					</div>
					
					<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
						{getPostsBySubcategory(subcategory).slice(0, 3).map(post => (
							<article class="card bg-base-100 border border-base-200 hover:shadow-md transition-shadow duration-300 h-full">
								<figure class="h-48 overflow-hidden">
									<img 
										src={post.data.heroImage}
										alt={post.data.title}
										class="w-full h-full object-cover"
									/>
								</figure>
								<div class="card-body p-6">
									<div class="text-xs font-medium text-base-content/70 mb-2">
										<FormattedDate date={post.data.pubDate} />
									</div>
									<h3 class="text-xl font-semibold mb-2 line-clamp-2">{post.data.title}</h3>
									<p class="text-sm mb-4 line-clamp-3 text-base-content/80">{post.data.description}</p>
									<div class="card-actions mt-auto">
										<a href={`/blog/${post.id}/`} class="btn btn-sm btn-ghost normal-case">
											Read More →
										</a>
									</div>
								</div>
							</article>
						))}
					</div>
				</section>
			))}

			<!-- Newsletter section -->
			<section class="card bg-base-200 mb-16">
				<div class="card-body p-8 text-center">
					<h2 class="text-2xl font-semibold mb-4">Stay Updated</h2>
					<p class="max-w-md mx-auto mb-6 text-base-content/80">Subscribe to our newsletter to receive the latest articles directly in your inbox.</p>
					<div class="flex flex-col sm:flex-row items-center justify-center gap-2 max-w-md mx-auto">
						<input type="email" placeholder="Your email address" class="input input-bordered w-full" />
						<button class="btn btn-primary w-full sm:w-auto">Subscribe</button>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>