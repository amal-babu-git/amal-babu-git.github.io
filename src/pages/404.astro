---
import PageLayout from "../layouts/PageLayout.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<PageLayout
	title={`404: Not Found | ${SITE_TITLE}`}
	description={SITE_DESCRIPTION}
>
	<h1 class="page-title font-display">Page not found</h1>
	<p class="page-lead">
		Nothing is served at <code
			class="missing-path"
			data-missing-path>this address</code
		>. It may have moved. Try the
		<a
			class="text-link"
			href="/">homepage</a
		> or the
		<a
			class="text-link"
			href="/blog">writing</a
		>.
	</p>
</PageLayout>

<script>
	const slot = document.querySelector("[data-missing-path]");
	if (slot) slot.textContent = window.location.pathname;
</script>

<style>
	.missing-path {
		font-size: 0.85em;
		padding: 0.1em 0.35em;
		border: 1px solid var(--rule);
		border-radius: 0.25rem;
		background: var(--paper);
		word-break: break-all;
	}
</style>
