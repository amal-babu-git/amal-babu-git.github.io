---
import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE } from "../consts";
---

<div
	class="navbar bg-base-200 sticky top-0 z-30 shadow-sm transition-all duration-300"
>
	<div class="navbar-start">
		<div class="dropdown lg:hidden">
			<div
				tabindex="0"
				role="button"
				class="btn btn-ghost"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="h-5 w-5"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M4 6h16M4 12h8m-8 6h16"
					></path>
				</svg>
			</div>
			<ul
				tabindex="0"
				class="menu dropdown-content mt-3 z-[1] p-4 shadow-lg bg-base-100 rounded-box w-64"
			>
				<li>
					<a
						href="/"
						class="hover:text-accent no-underline text-base py-3"
						>Home</a
					>
				</li>
				<li>
					<a
						href="/blog"
						class="hover:text-accent no-underline text-base py-3"
						>Blog</a
					>
				</li>
				<!-- <li><a href="/guides" class="hover:text-accent no-underline">Guides</a></li> -->
				<li>
					<a
						href="/projects"
						class="hover:text-accent no-underline text-base py-3"
						>Projects & OpenSource</a
					>
				</li>
				<li>
					<a
						href="/services"
						class="hover:text-accent no-underline text-base py-3"
						>Services</a
					>
				</li>
				<li>
					<a
						href="/about"
						class="hover:text-accent no-underline text-base py-3"
						>About</a
					>
				</li>
			</ul>
		</div>
		<a
			href="/"
			class="p-1 ms-1 font-normal text-xl normal-case no-underline"
			>{SITE_TITLE}</a
		>
	</div>

	<div class="navbar-center hidden lg:flex">
		<ul class="menu menu-horizontal px-1">
			<li>
				<HeaderLink
					href="/"
					>Home</HeaderLink
				>
			</li>
			<li>
				<HeaderLink
					href="/blog"
					>Blog</HeaderLink
				>
			</li>
			<!-- <li><HeaderLink href="/guides" class="no-underline">Guides</HeaderLink></li>  -->
			<li>
				<HeaderLink
					href="/projects"
					>Projects & OpenSource</HeaderLink
				>
			</li>
			<li>
				<HeaderLink
					href="/services"
					>Services</HeaderLink
				>
			</li>

			<li>
				<HeaderLink
					href="/about"
					>About</HeaderLink
				>
			</li>
		</ul>
	</div>

	<div class="navbar-end">
		<div class="flex gap-2 items-center">
			<label class="swap swap-rotate btn btn-ghost btn-circle">
				<!-- this hidden checkbox controls the state -->
				<input
					type="checkbox"
					id="theme-toggle"
					class="theme-controller"
					value="dark"
				/>

				<!-- sun icon -->
				<svg
					class="swap-off h-5 w-5 fill-current"
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
				>
					<path
						d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"
					></path>
				</svg>

				<!-- moon icon -->
				<svg
					class="swap-on h-5 w-5 fill-current"
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
				>
					<path
						d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z"
					></path>
				</svg>
			</label>

			<a
				href="https://github.com/amal-babu-git"
				target="_blank"
				class="btn btn-ghost btn-circle"
			>
				<span class="sr-only">Amal Babu GitHub Profile</span>
				<svg
					viewBox="0 0 16 16"
					aria-hidden="true"
					width="24"
					height="24"
					class="fill-current"
				>
					<path
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
		</div>
	</div>
</div>

<script>
	function setTheme(isDark: boolean) {
		const htmlElement = document.documentElement;
		htmlElement.setAttribute("data-theme", isDark ? "dark" : "light");
		localStorage.setItem("theme", isDark ? "dark" : "light");
	}

	const themeToggle = document.getElementById(
		"theme-toggle"
	) as HTMLInputElement;
	if (themeToggle) {
		themeToggle.addEventListener("change", () => {
			setTheme(themeToggle.checked);
		});
	}

	const savedTheme = localStorage.getItem("theme");
	if (savedTheme) {
		setTheme(savedTheme === "dark");
		if (themeToggle) themeToggle.checked = savedTheme === "dark";
	} else {
		const prefersDark = window.matchMedia(
			"(prefers-color-scheme: dark)"
		).matches;
		setTheme(prefersDark);
		if (themeToggle) themeToggle.checked = prefersDark;
	}
</script>
