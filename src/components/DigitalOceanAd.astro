---
const referralUrl =
	"https://www.digitalocean.com/?refcode=5765e29a5c3d&utm_campaign=Referral_Invite&utm_medium=Referral_Program&utm_source=badge";
---

<p class="referral">
	<a
		href={referralUrl}
		target="_blank"
		rel="noopener"
		class="referral-badge"
		tabindex="-1"
		aria-hidden="true"
	>
		<img
			src="https://web-platforms.sfo2.cdn.digitaloceanspaces.com/WWW/Badge%201.svg"
			alt=""
			width="40"
			height="40"
		/>
	</a>
	<span>
		New DigitalOcean accounts get $200 in free credit with
		<a
			href={referralUrl}
			target="_blank"
			rel="noopener"
			>my referral link</a
		>.
	</span>
</p>

<style>
	.referral {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0;
		max-width: 40rem;
	}

	.referral-badge {
		flex: none;
		line-height: 0;
	}

	.referral-badge img {
		width: 2.5rem;
		height: 2.5rem;
		opacity: 0.85;
	}

	.referral span a {
		color: var(--prussian);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>
