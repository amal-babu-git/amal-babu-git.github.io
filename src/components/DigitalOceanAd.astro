---
// No props needed for this ad component
---

<div
	class="card card-side bg-base-100 border border-base-200 shadow-sm max-w-xl mx-auto mb-4 sm:flex-row flex-col"
>
	<figure class="p-4 flex items-center justify-center sm:w-auto w-full">
		<a
			href="https://www.digitalocean.com/?refcode=5765e29a5c3d&utm_campaign=Referral_Invite&utm_medium=Referral_Program&utm_source=badge"
			target="_blank"
			rel="noopener"
			aria-label="DigitalOcean Referral"
		>
			<img
				src="https://web-platforms.sfo2.cdn.digitaloceanspaces.com/WWW/Badge%201.svg"
				alt="DigitalOcean Referral Badge"
				class="w-16 h-16 sm:w-20 sm:h-20 object-contain opacity-80"
			/>
		</a>
	</figure>
	<div
		class="card-body p-4 flex flex-col justify-center sm:items-start items-center text-center sm:text-left"
	>
		<h3
			class="card-title text-base-content text-base sm:text-lg font-semibold mb-1"
		>
			Get <span class="text-base-content/70">$200 Free Credits</span> on DigitalOcean
		</h3>
		<p class="text-base-content/60 text-sm mb-3 max-w-md">
			Launch cloud servers, host your projects, and scale with ease.<br />
			<span class="font-semibold text-base-content/80"
				>Sign up with my referral and start building today!</span
			>
		</p>
		<a
			href="https://www.digitalocean.com/?refcode=5765e29a5c3d&utm_campaign=Referral_Invite&utm_medium=Referral_Program&utm_source=badge"
			target="_blank"
			rel="noopener"
			class="btn btn-neutral btn-sm normal-case shadow-sm"
			aria-label="Claim your free DigitalOcean credits"
		>
			Claim Your Free Credits
		</a>
	</div>
</div>
