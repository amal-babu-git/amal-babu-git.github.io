---
// CTASection.astro - Call to Action section component
---

<!-- Contact Section -->
<section
	class="mt-12 card bg-primary/5 shadow-lg"
	id="contact"
>
	<div class="card-body p-8">
		<div class="text-center mb-8">
			<h2 class="text-3xl font-bold mb-4">Ready to Start Your Project?</h2>
			<p class="text-lg text-base-content/80 max-w-2xl mx-auto">
				Get a free consultation and quote for your website development needs.
				Let's discuss how I can help your business succeed online.
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
			<div class="text-center">
				<div class="text-primary hover:text-secondary text-4xl mb-2">
					<svg
						class="w-12 h-12 mx-auto"
						fill="currentColor"
						viewBox="0 0 20 20"
					>
						<path
							d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"
						></path>
						<path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"
						></path>
					</svg>
				</div>
				<h3 class="font-semibold mb-1 hover:text-secondary">Email</h3>
				<a
					href="mailto:developer.amalbabu@gmail.com"
					class="text-primary hover:text-secondary hover:underline"
				>
					developer.amalbabu@gmail.com
				</a>
			</div>
			<div class="text-center">
				<div class="text-primary hover:text-secondary text-4xl mb-2">
					<svg
						class="w-12 h-12 mx-auto"
						fill="currentColor"
						viewBox="0 0 20 20"
					>
						<path
							d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"
						></path>
					</svg>
				</div>
				<h3 class="font-semibold mb-1 hover:text-secondary">Phone</h3>
				<a
					href="tel:+919074631926"
					class="text-primary hover:text-secondary hover:underline"
				>
					(+91) 9074631926
				</a>
			</div>
			<div class="text-center">
				<div class="text-primary hover:text-secondary text-4xl mb-2">
					<svg
						class="w-12 h-12 mx-auto"
						fill="currentColor"
						viewBox="0 0 20 20"
					>
						<path
							fill-rule="evenodd"
							d="M4.083 9h1.946c.089-1.546.383-2.97.837-4.118A6.004 6.004 0 004.083 9zM10 2a8 8 0 100 16 8 8 0 000-16zm0 2c-.076 0-.232.032-.465.262-.238.234-.497.623-.737 1.182-.389.907-.673 2.142-.766 3.556h3.936c-.093-1.414-.377-2.649-.766-3.556-.24-.56-.5-.948-.737-1.182C10.232 4.032 10.076 4 10 4zm3.971 5c-.089-1.546-.383-2.97-.837-4.118A6.004 6.004 0 0115.917 9h-1.946zm-2.003 2H8.032c.093 1.414.377 2.649.766 3.556.24.56.5.948.737 1.182.233.23.389.262.465.262.076 0 .232-.032.465-.262.238-.234.498-.623.737-1.182.389-.907.673-2.142.766-3.556zm1.166 4.118c.454-1.147.748-2.572.837-4.118h1.946a6.004 6.004 0 01-2.783 4.118zm-6.268 0C6.412 13.97 6.118 12.546 6.03 11H4.083a6.004 6.004 0 002.783 4.118z"
							clip-rule="evenodd"
						></path>
					</svg>
				</div>
				<h3 class="font-semibold mb-1 hover:text-secondary">Website</h3>
				<p class="text-base-content/80 hover:text-secondary">
					amal-babu-git.github.io
				</p>
			</div>
		</div>
	</div>
</section>
