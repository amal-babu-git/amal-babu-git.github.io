---
// The homepage diagram: the kind of system Amal builds, drawn as an
// architecture diagram. Every box links to the work behind it.

const MONOLITH_POST =
	"/blog/coding-and-development/building-scalable-modular-monoliths-fastapi/";
const TEMPLATE = "/projects#fastapi-template";
const WORK = "/about#experience";

// Edges that touch the monolith, used by everything inside it.
const MONOLITH_EDGES = "api-monolith agents-monolith monolith-postgres monolith-redis";

type Node = {
	id: string;
	label: string;
	sub?: string;
	x: number;
	y: number;
	w: number;
	h: number;
	href: string;
	caption: string;
	edges: string;
	peers: string;
	kind: "box" | "module" | "title";
};

const nodes: Node[] = [
	{
		id: "frontends",
		label: "Frontends",
		sub: "Next.js, React",
		x: 150, y: 12, w: 180, h: 52,
		href: WORK,
		caption: "Web frontends in Next.js, React and Astro for the business systems I build.",
		edges: "frontends-api",
		peers: "api",
		kind: "box",
	},
	{
		id: "api",
		label: "API layer",
		sub: "FastAPI, Django REST",
		x: 40, y: 112, w: 180, h: 52,
		href: TEMPLATE,
		caption: "Backends in FastAPI and Django REST Framework. My FastAPI starting point is open source.",
		edges: "frontends-api api-agents api-monolith",
		peers: "frontends agents monolith boundary",
		kind: "box",
	},
	{
		id: "agents",
		label: "AI agents",
		sub: "Pydantic AI, LangGraph",
		x: 280, y: 112, w: 180, h: 52,
		href: WORK,
		caption: "Automation inside business software, built with Pydantic AI and LangGraph.",
		edges: "api-agents agents-monolith",
		peers: "api monolith boundary",
		kind: "box",
	},
	{
		id: "monolith",
		label: "Modular monolith",
		x: 160, y: 194, w: 160, h: 20,
		href: MONOLITH_POST,
		caption: "One deployable, split into modules by business domain. I wrote up how I structure these.",
		edges: MONOLITH_EDGES,
		peers: "boundary accounting hr inventory hospital campaigns auth api agents postgres redis",
		kind: "title",
	},
	{
		id: "accounting",
		label: "Accounting",
		x: 36, y: 232, w: 128, h: 44,
		href: WORK,
		caption: "Accounting workflows in the business systems I build at Hybrid Interactive.",
		edges: MONOLITH_EDGES,
		peers: "monolith boundary",
		kind: "module",
	},
	{
		id: "hr",
		label: "HR",
		x: 176, y: 232, w: 128, h: 44,
		href: WORK,
		caption: "Human resources management workflows.",
		edges: MONOLITH_EDGES,
		peers: "monolith boundary",
		kind: "module",
	},
	{
		id: "inventory",
		label: "Inventory",
		x: 316, y: 232, w: 128, h: 44,
		href: WORK,
		caption: "Inventory and stock management workflows.",
		edges: MONOLITH_EDGES,
		peers: "monolith boundary",
		kind: "module",
	},
	{
		id: "hospital",
		label: "Hospital",
		x: 36, y: 290, w: 128, h: 44,
		href: WORK,
		caption: "Hospital and pharmacy management for healthcare clients.",
		edges: MONOLITH_EDGES,
		peers: "monolith boundary",
		kind: "module",
	},
	{
		id: "campaigns",
		label: "Campaigns",
		x: 176, y: 290, w: 128, h: 44,
		href: WORK,
		caption: "Campaign workflows for an influencer marketing platform, where brands run ad campaigns with creators.",
		edges: MONOLITH_EDGES,
		peers: "monolith boundary",
		kind: "module",
	},
	{
		id: "auth",
		label: "Auth, RBAC",
		x: 316, y: 290, w: 128, h: 44,
		href: TEMPLATE,
		caption: "JWT with refresh tokens and role-based access, shared by every module.",
		edges: MONOLITH_EDGES,
		peers: "monolith boundary",
		kind: "module",
	},
	{
		id: "postgres",
		label: "PostgreSQL",
		sub: "SQLAlchemy 2.0, Alembic",
		x: 40, y: 404, w: 180, h: 52,
		href: TEMPLATE,
		caption: "Accessed through async SQLAlchemy 2.0, with Alembic migrations.",
		edges: "monolith-postgres",
		peers: "monolith boundary",
		kind: "box",
	},
	{
		id: "redis",
		label: "Redis, Celery",
		sub: "Cache, background jobs",
		x: 280, y: 404, w: 180, h: 52,
		href: TEMPLATE,
		caption: "Caching, plus Celery background jobs monitored with Flower.",
		edges: "monolith-redis",
		peers: "monolith boundary",
		kind: "box",
	},
];

// Arrows point the way dependencies run. `step` orders the draw-in.
const down = (x: number, y: number) => `M${x - 4} ${y - 6} L${x} ${y} L${x + 4} ${y - 6}`;
const right = (x: number, y: number) => `M${x - 6} ${y - 4} L${x} ${y} L${x - 6} ${y + 4}`;

const edges = [
	{ id: "frontends-api", d: "M240 64 V86 H130 V112", arrow: down(130, 112), step: 0 },
	{ id: "api-agents", d: "M220 138 H280", arrow: right(280, 138), step: 1 },
	{ id: "api-monolith", d: "M130 164 V204", arrow: down(130, 204), step: 2 },
	{ id: "agents-monolith", d: "M370 164 V204", arrow: down(370, 204), step: 2 },
	{ id: "monolith-postgres", d: "M130 356 V404", arrow: down(130, 404), step: 3 },
	{ id: "monolith-redis", d: "M370 356 V404", arrow: down(370, 404), step: 3 },
];

// Optional figure label and caption, for pages that cite the diagram.
const { figureLabel, caption } = Astro.props as { figureLabel?: string; caption?: string };

const defaultCaption =
	caption ?? "Each box is part of a system I've built. Select one to read more.";
---

<figure
	class="diagram"
	data-diagram
>
	<svg
		viewBox="0 0 480 460"
		role="group"
		aria-label="Architecture of the systems I build"
	>
		<defs>
			<pattern
				id="drafting-grid"
				width="20"
				height="20"
				patternUnits="userSpaceOnUse"
			>
				<path
					class="grid-line"
					d="M20 0 H0 V20"
					fill="none"></path>
			</pattern>
			<radialGradient id="grid-fade">
				<stop
					offset="55%"
					stop-color="#fff"></stop>
				<stop
					offset="100%"
					stop-color="#fff"
					stop-opacity="0"></stop>
			</radialGradient>
			<mask id="grid-mask">
				<rect
					x="-20"
					y="-20"
					width="520"
					height="500"
					fill="url(#grid-fade)"></rect>
			</mask>
		</defs>

		<rect
			x="-20"
			y="-20"
			width="520"
			height="500"
			fill="url(#drafting-grid)"
			mask="url(#grid-mask)"
			aria-hidden="true"></rect>

		<g aria-hidden="true">
			{
				edges.map((edge) => (
					<g
						class="edge-group"
						data-edge={edge.id}
						style={`--step: ${edge.step}`}
					>
						<path
							class="edge"
							d={edge.d}
							pathLength="1"
						/>
						<path
							class="arrow"
							d={edge.arrow}
						/>
					</g>
				))
			}
			<rect
				class="boundary"
				data-peer="boundary"
				x="16"
				y="204"
				width="448"
				height="152"
				rx="4"></rect>
		</g>

		{
			nodes.map((node) => (
				<a
					href={node.href}
					class:list={["node", node.kind, { "has-sub": node.sub }]}
					data-node
					data-peer={node.id}
					data-label={node.label}
					data-caption={node.caption}
					data-edges={node.edges}
					data-peers={node.peers}
					aria-label={`${node.label}: ${node.caption}`}
				>
					<rect
						x={node.x}
						y={node.y}
						width={node.w}
						height={node.h}
						rx={node.kind === "title" ? 0 : 3}
					/>
					<text
						class="node-label"
						x={node.x + node.w / 2}
						y={
							node.kind === "title"
								? node.y + 14
								: node.sub
									? node.y + 23
									: node.y + node.h / 2 + 5
						}
						text-anchor="middle"
					>
						{node.label}
					</text>
					{node.sub && (
						<text
							class="sub"
							x={node.x + node.w / 2}
							y={node.y + 41}
							text-anchor="middle"
						>
							{node.sub}
						</text>
					)}
				</a>
			))
		}
	</svg>
	<figcaption class="diagram-caption">
		{figureLabel && <span class="figure-label">{figureLabel}</span>}
		<span data-caption-slot>{defaultCaption}</span>
	</figcaption>
</figure>

<script>
	for (const root of document.querySelectorAll<HTMLElement>("[data-diagram]")) {
		const slot = root.querySelector<HTMLElement>("[data-caption-slot]");
		const defaultText = slot?.textContent?.trim() ?? "";

		const clear = () => {
			root.classList.remove("is-tracing");
			root
				.querySelectorAll(".is-lit")
				.forEach((el) => el.classList.remove("is-lit"));
			if (slot) slot.textContent = defaultText;
		};

		const trace = (node: SVGElement) => {
			clear();
			root.classList.add("is-tracing");
			node.classList.add("is-lit");
			for (const id of (node.dataset.edges ?? "").split(" ")) {
				root.querySelector(`[data-edge="${id}"]`)?.classList.add("is-lit");
			}
			for (const id of (node.dataset.peers ?? "").split(" ")) {
				root.querySelector(`[data-peer="${id}"]`)?.classList.add("is-lit");
			}
			if (slot) {
				const label = document.createElement("strong");
				label.textContent = node.dataset.label ?? "";
				slot.replaceChildren(label, ` ${node.dataset.caption ?? ""}`);
			}
		};

		for (const node of root.querySelectorAll<SVGElement>("[data-node]")) {
			node.addEventListener("pointerenter", () => trace(node));
			node.addEventListener("focus", () => trace(node));
			node.addEventListener("pointerleave", clear);
			node.addEventListener("blur", clear);
		}
	}
</script>

<style>
	.diagram {
		margin: 0;
		width: 100%;
		max-width: 34rem;
	}

	svg {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
	}

	.grid-line {
		stroke: var(--rule);
		stroke-width: 1;
		opacity: 0.55;
	}

	.edge,
	.arrow {
		fill: none;
		stroke: var(--ink);
		stroke-width: 1.25;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.boundary {
		fill: none;
		stroke: var(--graphite);
		stroke-width: 1.25;
		stroke-dasharray: 6 5;
	}

	.node {
		cursor: pointer;
		outline: none;
	}

	.node rect {
		fill: var(--paper);
		stroke: var(--ink);
		stroke-width: 1.25;
	}

	.node .node-label {
		fill: var(--ink);
		font-family: var(--font-text);
		font-size: 15px;
		font-weight: 500;
	}

	.node .sub {
		fill: var(--graphite);
		font-family: var(--font-text);
		font-size: 12px;
	}

	.module .node-label {
		font-size: 14px;
	}

	/* The monolith's name sits on its boundary, like a drawing title. */
	.title rect {
		fill: var(--film);
		stroke: none;
	}

	.title .node-label {
		font-family: var(--font-heading);
		font-stretch: 118%;
		font-size: 13px;
		font-weight: 600;
	}

	/* Tracing: the selected box, its connections and neighbours stay; the rest recede. */
	.edge-group,
	.boundary,
	.node {
		transition: opacity 160ms ease;
	}

	.is-tracing .edge-group:not(.is-lit),
	.is-tracing .boundary:not(.is-lit),
	.is-tracing .node:not(.is-lit) {
		opacity: 0.25;
	}

	.edge-group.is-lit .edge,
	.edge-group.is-lit .arrow {
		stroke: var(--prussian);
		stroke-width: 1.75;
	}

	.boundary.is-lit {
		stroke: var(--prussian);
	}

	.node.is-lit rect {
		stroke: var(--prussian);
	}

	.title.is-lit rect {
		stroke: none;
	}

	.title.is-lit .node-label {
		fill: var(--prussian);
	}

	.node:is(:hover, :focus-visible) rect {
		fill: color-mix(in srgb, var(--prussian) 8%, var(--paper));
		stroke: var(--prussian);
	}

	.title:is(:hover, :focus-visible) rect {
		fill: var(--film);
	}

	.node:is(:hover, :focus-visible) .node-label {
		fill: var(--prussian);
	}

	.node:focus-visible rect {
		stroke-width: 2.5;
	}

	.title:focus-visible .node-label {
		text-decoration: underline;
	}

	.diagram-caption {
		margin-top: 1rem;
		min-height: 3.2em;
		max-width: 32rem;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--graphite);
	}

	.figure-label {
		color: var(--ink);
		font-weight: 600;
		margin-right: 0.25em;
	}

	.diagram-caption :global(strong) {
		color: var(--ink);
		font-weight: 600;
	}

	/* One moment of motion: the connectors draw in once, in dependency order. */
	@media (prefers-reduced-motion: no-preference) {
		.edge {
			stroke-dasharray: 1;
			animation: draw 520ms cubic-bezier(0.3, 0.7, 0.3, 1) both;
			animation-delay: calc(250ms + var(--step) * 200ms);
		}

		.arrow {
			animation: appear 140ms linear both;
			animation-delay: calc(700ms + var(--step) * 200ms);
		}
	}

	@keyframes draw {
		from {
			stroke-dashoffset: 1;
		}
		to {
			stroke-dashoffset: 0;
		}
	}

	@keyframes appear {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	/* Narrow screens: drop the second line so labels can stay readable. */
	@media (max-width: 519px) {
		.node .sub {
			display: none;
		}

		.node .node-label {
			font-size: 18px;
		}

		.has-sub .node-label {
			transform: translateY(8px);
		}

		.module .node-label {
			font-size: 16px;
		}

		.title .node-label {
			font-size: 14px;
		}
	}
</style>
