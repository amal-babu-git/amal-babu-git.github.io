---
// The GitHub contribution heat map for the last year, as a calendar or as
// isometric 3D bars. Both views are SVG drawn at build time; the only script
// switches between them. Data comes from GitHub's API when the build has a
// token (the deploy workflow passes one), otherwise from the saved copy in
// src/data, which `npm run contributions` refreshes.
import snapshot from "../data/github-contributions.json";
import { getContributions } from "../utils/github-contributions.mjs";

type Day = { date: string; weekday: number; count: number; level: number };
type Contributions = { login: string; total: number; private: number; weeks: Day[][] };

const data: Contributions = await getContributions(process.env.GITHUB_TOKEN, snapshot);

const days = data.weeks.flat();
const max = Math.max(1, ...days.map((day) => day.count));
const activeDays = days.filter((day) => day.count > 0).length;
const best = days.reduce((top, day) => (day.count > top.count ? day : top), days[0]);
let longestStreak = 0;
let run = 0;
for (const day of days) {
	run = day.count > 0 ? run + 1 : 0;
	longestStreak = Math.max(longestStreak, run);
}

const asDate = (iso: string) => new Date(`${iso}T00:00:00Z`);
const shortDate = (iso: string) =>
	asDate(iso).toLocaleDateString("en-us", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
const plural = (n: number, word: string) => `${n.toLocaleString("en-us")} ${word}${n === 1 ? "" : "s"}`;
const dayTitle = (day: Day) =>
	`${day.count === 0 ? "No contributions" : plural(day.count, "contribution")} on ${shortDate(day.date)}`;
const until = shortDate(days.at(-1)?.date ?? "");

// Calendar: one column per week, Sunday at the top, as on GitHub.
const STEP = 13;
const CELL = 10;
const LEFT = 30;
const TOP = 18;
const calWidth = LEFT + data.weeks.length * STEP - (STEP - CELL);
const calHeight = TOP + 7 * STEP - (STEP - CELL);
// Weeks where a new month starts, labelled in both views.
const months: { w: number; label: string }[] = [];
data.weeks.forEach((week, w) => {
	const month = asDate(week[0].date).getUTCMonth();
	const previous = w > 0 ? asDate(data.weeks[w - 1][0].date).getUTCMonth() : -1;
	if (month !== previous && (months.length === 0 || w - months.at(-1)!.w >= 3)) {
		months.push({ w, label: asDate(week[0].date).toLocaleDateString("en-us", { month: "short", timeZone: "UTC" }) });
	}
});
// A label squeezed in before the first full month would collide with it.
if (months.length > 1 && months[1].w - months[0].w < 3) months.shift();

// 3D: each day is an isometric bar; height grows with the square root of the
// count, so busy days stand out without flattening ordinary ones.
const A = 8; // half the width of a cell's top face
const B = 4.6; // half its height
const MAX_HEIGHT = 64;
const PAD = 6;
const originX = PAD + 7 * A;
const originY = PAD + MAX_HEIGHT + B;
const r = (n: number) => Math.round(n * 10) / 10;
const isoWidth = Math.ceil(originX + (data.weeks.length - 1) * A + A + PAD);
// Room below the front edge for the month labels.
const isoHeight = Math.ceil(originY + (data.weeks.length + 6) * B + B + PAD + 16);
// Month labels run along the front edge (Saturdays), at the edge's 30° slope.
const SLOPE = (Math.atan2(B, A) * 180) / Math.PI;
const isoMonths = months.map((month) => {
	const x = originX + (month.w - 6) * A;
	const y = originY + (month.w + 6) * B + B + 11;
	return { label: month.label, x: r(x), y: r(y), rotate: `rotate(${r(SLOPE)} ${r(x)} ${r(y)})` };
});
const pts = (...xy: number[]) => {
	const pairs: string[] = [];
	for (let i = 0; i < xy.length; i += 2) pairs.push(`${r(xy[i])},${r(xy[i + 1])}`);
	return pairs.join(" ");
};
const bars = data.weeks
	.flatMap((week, w) => week.map((day) => ({ day, w, d: day.weekday })))
	// Back to front, so nearer bars are drawn over the ones behind them.
	.sort((a, b) => a.w + a.d - (b.w + b.d) || a.w - b.w)
	.map(({ day, w, d }) => {
		const x = originX + (w - d) * A;
		const y = originY + (w + d) * B;
		const h = day.count > 0 ? 3 + Math.sqrt(day.count / max) * MAX_HEIGHT : 0;
		return {
			level: day.level,
			top: pts(x, y - B - h, x + A, y - h, x, y + B - h, x - A, y - h),
			left: h > 0 ? pts(x - A, y - h, x, y + B - h, x, y + B, x - A, y) : null,
			right: h > 0 ? pts(x, y + B - h, x + A, y - h, x + A, y, x, y + B) : null,
		};
	});

const summary = `${plural(data.total, "contribution")} in the year to ${until}`;
const profileUrl = `https://github.com/${data.login}`;
---

<div
	class="gh"
	data-gh-activity
	data-view="calendar"
>
	<div class="gh-head">
		<p class="gh-total">{summary}</p>
		<div
			class="gh-toggle"
			role="group"
			aria-label="View"
			data-gh-toggle
			hidden
		>
			<button
				type="button"
				data-view-button="calendar"
				aria-pressed="true">Calendar</button
			>
			<button
				type="button"
				data-view-button="3d"
				aria-pressed="false">3D</button
			>
		</div>
	</div>

	<div
		class="gh-view gh-calendar"
		data-gh-scroll
	>
		<svg
			viewBox={`0 0 ${calWidth} ${calHeight}`}
			width={calWidth}
			height={calHeight}
			role="img"
			aria-label={`Contribution calendar: ${summary}`}
		>
			{
				months.map((month) => (
					<text
						class="gh-label"
						x={LEFT + month.w * STEP}
						y="10"
					>
						{month.label}
					</text>
				))
			}
			{
				[
					[1, "Mon"],
					[3, "Wed"],
					[5, "Fri"],
				].map(([row, label]) => (
					<text
						class="gh-label"
						x="0"
						y={TOP + (row as number) * STEP + 9}
					>
						{label}
					</text>
				))
			}
			{
				data.weeks.map((week, w) =>
					week.map((day) => (
						<rect
							class={`l${day.level}`}
							x={LEFT + w * STEP}
							y={TOP + day.weekday * STEP}
							width={CELL}
							height={CELL}
							rx="2"
						>
							<title>{dayTitle(day)}</title>
						</rect>
					)),
				)
			}
		</svg>
	</div>

	<div class="gh-view gh-iso">
		<svg
			viewBox={`0 0 ${isoWidth} ${isoHeight}`}
			role="img"
			aria-label={`Contributions as 3D bars: ${summary}`}
		>
			{
				bars.map((bar) => (
					<g class={`b${bar.level}`}>
						{bar.left && (
							<polygon
								class="sl"
								points={bar.left}
							/>
						)}
						{bar.right && (
							<polygon
								class="sr"
								points={bar.right}
							/>
						)}
						<polygon
							class="st"
							points={bar.top}
						/>
					</g>
				))
			}
			{
				isoMonths.map((month) => (
					<text
						class="gh-label"
						x={month.x}
						y={month.y}
						transform={month.rotate}
					>
						{month.label}
					</text>
				))
			}
		</svg>
	</div>

	<div class="gh-foot">
		<p class="gh-stats">
			{plural(activeDays, "active day")} · busiest day {plural(best.count, "contribution")} on {
				shortDate(best.date)
			} · longest streak {plural(longestStreak, "day")}
		</p>
		<p
			class="gh-legend"
			aria-hidden="true"
		>
			Less
			{[0, 1, 2, 3, 4].map((level) => <span class={`l${level}`} />)}
			More
		</p>
	</div>
	<p class="gh-link">
		<a
			class="text-link"
			href={profileUrl}>{profileUrl.replace("https://", "")}</a
		>
	</p>
</div>

<script>
	for (const root of document.querySelectorAll<HTMLElement>("[data-gh-activity]")) {
		const toggle = root.querySelector<HTMLElement>("[data-gh-toggle]");
		const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-view-button]")];
		const scroller = root.querySelector<HTMLElement>("[data-gh-scroll]");
		const show = (view: string) => {
			root.dataset.view = view;
			for (const button of buttons) {
				button.setAttribute("aria-pressed", String(button.dataset.viewButton === view));
			}
		};
		for (const button of buttons) {
			button.addEventListener("click", () => show(button.dataset.viewButton ?? "calendar"));
		}
		// Without this script the calendar shows on its own, with no toggle.
		if (toggle) toggle.hidden = false;
		// On a narrow screen the calendar scrolls; start at the latest weeks.
		if (scroller) scroller.scrollLeft = scroller.scrollWidth;
	}
</script>

<style is:global>
	/* Global but prefixed with .gh: scoped styles would tag each of the
	   ~1,300 SVG shapes with an attribute, which adds up. */
	.gh {
		/* GitHub's five levels, in the site's blue instead of GitHub's green. */
		--heat-0: color-mix(in srgb, var(--rule) 55%, var(--paper));
		--heat-1: color-mix(in srgb, var(--prussian) 34%, var(--paper));
		--heat-2: color-mix(in srgb, var(--prussian) 58%, var(--paper));
		--heat-3: color-mix(in srgb, var(--prussian) 80%, var(--paper));
		--heat-4: var(--prussian);
		min-width: 0;
	}

	.gh .gh-head,
	.gh .gh-foot {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 1rem;
	}

	.gh .gh-total {
		margin: 0;
		font-weight: 600;
	}

	.gh .gh-toggle {
		display: inline-flex;
		border: 1px solid var(--rule);
		border-radius: 0.375rem;
		overflow: hidden;
	}

	.gh .gh-toggle[hidden] {
		display: none;
	}

	.gh .gh-toggle button {
		padding: 0.25rem 0.75rem;
		font: inherit;
		font-size: 0.875rem;
		color: var(--graphite);
		background: transparent;
		border: 0;
		cursor: pointer;
	}

	.gh .gh-toggle button + button {
		border-left: 1px solid var(--rule);
	}

	.gh .gh-toggle button[aria-pressed="true"] {
		color: var(--ink);
		background: color-mix(in srgb, var(--ink) 7%, transparent);
	}

	.gh .gh-toggle button:focus-visible {
		outline: 2px solid var(--prussian);
		outline-offset: -2px;
	}

	.gh .gh-view {
		margin-top: 1rem;
	}

	.gh[data-view="calendar"] .gh-iso,
	.gh[data-view="3d"] .gh-calendar {
		display: none;
	}

	.gh .gh-calendar {
		overflow-x: auto;
		padding-bottom: 0.25rem;
	}

	/* Fills the column; below this width it stops shrinking and scrolls. */
	.gh .gh-calendar svg {
		display: block;
		width: 100%;
		min-width: 36rem;
		height: auto;
	}

	.gh .gh-iso svg {
		display: block;
		width: 100%;
		max-width: 40rem;
		height: auto;
	}

	.gh .gh-label {
		fill: var(--graphite);
		font-family: var(--font-text);
		font-size: 10px;
	}

	.gh .l0 {
		fill: var(--heat-0);
		background: var(--heat-0);
	}

	.gh .l1 {
		fill: var(--heat-1);
		background: var(--heat-1);
	}

	.gh .l2 {
		fill: var(--heat-2);
		background: var(--heat-2);
	}

	.gh .l3 {
		fill: var(--heat-3);
		background: var(--heat-3);
	}

	.gh .l4 {
		fill: var(--heat-4);
		background: var(--heat-4);
	}

	.gh .b0 {
		--face: var(--heat-0);
	}

	.gh .b1 {
		--face: var(--heat-1);
	}

	.gh .b2 {
		--face: var(--heat-2);
	}

	.gh .b3 {
		--face: var(--heat-3);
	}

	.gh .b4 {
		--face: var(--heat-4);
	}

	/* Light from the top left: the top face is the level's colour, the sides darker. */
	.gh .st {
		fill: var(--face);
		stroke: var(--paper);
		stroke-width: 0.5;
	}

	.gh .sl {
		fill: color-mix(in srgb, var(--face) 84%, #000);
	}

	.gh .sr {
		fill: color-mix(in srgb, var(--face) 70%, #000);
	}

	.gh .gh-foot {
		margin-top: 0.75rem;
		font-size: 0.875rem;
		color: var(--graphite);
	}

	.gh .gh-stats {
		margin: 0;
	}

	.gh .gh-legend {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		margin: 0;
	}

	.gh .gh-legend span {
		width: 10px;
		height: 10px;
		border-radius: 2px;
	}

	.gh .gh-link {
		margin: 0.5rem 0 0;
		font-size: 0.875rem;
	}
</style>
