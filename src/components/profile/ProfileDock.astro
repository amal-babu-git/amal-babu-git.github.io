				></path>
			</svg>
			<span class="dock-label text-xs">Certs</span>
		</button>

		<button
			data-section="projects"
			class="dock-button"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="24"
				height="24"
				fill="currentColor"
				viewBox="0 0 16 16"
			>
				<path
					d="M14.25 6.12v6.5a.25.25 0 0 1-.25.25H2a.25.25 0 0 1-.25-.25v-6.5a.25.25 0 0 1 .25-.25h12a.25.25 0 0 1 .25.25ZM2 4.25v1a.25.25 0 0 1-.25.25h12a.25.25 0 0 1-.25-.25v-1a.25.25 0 0 1 .25-.25h12a.25.25 0 0 1 .25.25v1a.25.25 0 0 1-.25.25H2a.25.25 0 0 1-.25-.25v-1a.25.25 0 0 1 .25-.25h12a.25.25 0 0 1 .25.25v1a.25.25 0 0 1-.25.25H2a.25.25 0 0 1-.25-.25v-1a.25.25 0 0 1 .25-.25h12a.25.25 0 0 1 .25.25Z"
				></path>
				<path
					d="M9.05.435c-.58-.58-1.52-.58-2.1 0L.436 6.95c-.58.58-.58 1.519 0 2.098l6.516 6.516c.58.58 1.519.58 2.098 0l6.516-6.516c.58-.58.58-1.519 0-2.098L9.05.435Zm-1.4.7a.495.495 0 0 1 .7 0l6.516 6.515a.495.495 0 0 1 0 .7L8.35 14.866a.495.495 0 0 1-.7 0L1.134 8.35a.495.495 0 0 1 0-.7L7.65 1.134Z"
				></path>
				<path d="M7.5 6a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"></path>
			</svg>
			<span class="dock-label text-xs">Projects</span>
		</button>

		<button
			data-section="connect"
			class="dock-button"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="24"
				height="24"
				fill="currentColor"
				viewBox="0 0 16 16"
			>
				<path
					d="M6 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm-5 6s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H1zM11 3.5a.5.5 0 0 1 .5-.5h4a.5.5 0 0 1 0 1h-4a.5.5 0 0 1-.5-.5zm.5 2.5a.5.5 0 0 0 0 1h4a.5.5 0 0 0 0-1h-4zm2 3a.5.5 0 0 0 0 1h2a.5.5 0 0 0 0-1h-2zm0 3a.5.5 0 0 0 0 1h2a.5.5 0 0 0 0-1h-2z"
				></path>
			</svg>
			<span class="dock-label text-xs">Connect</span>
		</button>
	</div>
</div>

<script>
	// Client-side code - will run in the browser
	document.addEventListener("DOMContentLoaded", function () {
		// Add click handlers for all dock buttons
		const dockButtons = document.querySelectorAll(".dock button");

		dockButtons.forEach((button) => {
			button.addEventListener("click", function (this: HTMLButtonElement) {
				const sectionId = this.getAttribute("data-section");
				scrollToSection(sectionId);
			});
		});

		function scrollToSection(sectionId: string | null): void {
			if (sectionId === null) return;

			const section = document.getElementById(sectionId);
			if (section) {
				section.scrollIntoView({ behavior: "smooth" });

				// Update active state
				dockButtons.forEach((btn) => {
					if (btn.getAttribute("data-section") === sectionId) {
						btn.classList.add("dock-active");
					} else {
						btn.classList.remove("dock-active");
					}
				});
			}
		}

		// Intersection Observer to update active button based on scroll
		const sections = [
			"skills",
			"experience",
			"education",
			"certifications",
			"projects",
			"connect",
		];

		const observerOptions = {
			root: null,
			rootMargin: "-10% 0px -10% 0px", // Smaller margins for more accurate detection
			threshold: [0, 0.1, 0.25, 0.5, 0.75, 1.0], // More granular thresholds
		};

		let currentActiveSection = "";
		const sectionVisibility = new Map();

		const observer = new IntersectionObserver((entries) => {
			// Update visibility map
			entries.forEach((entry) => {
				sectionVisibility.set(entry.target.id, {
					isIntersecting: entry.isIntersecting,
					intersectionRatio: entry.intersectionRatio
				});
			});

			// Find the most visible section
			let mostVisibleSection = "";
			let highestRatio = 0;

			sectionVisibility.forEach((data, sectionId) => {
				if (data.isIntersecting && data.intersectionRatio > highestRatio) {
					highestRatio = data.intersectionRatio;
					mostVisibleSection = sectionId;
				}
			});

			// Only update if we have a different active section
			if (mostVisibleSection && mostVisibleSection !== currentActiveSection) {
				currentActiveSection = mostVisibleSection;
				
				dockButtons.forEach((button) => {
					if (button.getAttribute("data-section") === mostVisibleSection) {
						button.classList.add("dock-active");
					} else {
						button.classList.remove("dock-active");
					}
				});
			}
		}, observerOptions);

		// Observe all sections
		sections.forEach((section) => {
			const element = document.getElementById(section);
			if (element) observer.observe(element);
		});
	});
</script>

<style>
	.dock {
		animation: fadeIn 0.5s ease-in-out;
		transition:
			transform 0.3s,
			opacity 0.3s;
		min-width: fit-content;
	}

	.dock:hover {
		transform: translateY(-5px) translateX(-50%) scale(1.05);
	}

	.dock-button {
		transition:
			transform 0.2s,
			opacity 0.2s;
		cursor: pointer;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 0.375rem;
		background: transparent;
		border: none;
	}

	.dock-button:hover {
		transform: translateY(-5px);
	}

	.dock-active {
		color: var(--color-primary);
		transform: translateY(-5px);
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(20px) translateX(-50%);
		}
		to {
			opacity: 1;
			transform: translateY(0) translateX(-50%);
		}
	}
</style>
