---
import DigitalOceanAd from "./DigitalOceanAd.astro";
import { SOCIAL_LINKS } from "../consts";
const today = new Date();
---

<footer class="site-footer">
	<div class="shell footer-inner">
		<div class="footer-row">
			<p>&copy; {today.getFullYear()} Amal Babu, ABK DataLab</p>
			<ul class="footer-links">
				<li><a href={SOCIAL_LINKS.github}>GitHub</a></li>
				<li><a href={SOCIAL_LINKS.linkedin}>LinkedIn</a></li>
				<li><a href={SOCIAL_LINKS.medium}>Medium</a></li>
				<li><a href={`mailto:${SOCIAL_LINKS.email}`}>Email</a></li>
				<li><a href="/licenses/">Software licenses</a></li>
			</ul>
		</div>
		<DigitalOceanAd />
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--rule);
		font-family: var(--font-text);
		font-size: 0.9375rem;
		color: var(--graphite);
	}

	.footer-inner {
		display: grid;
		gap: 1.5rem;
		padding-block: 2.5rem 3rem;
	}

	.footer-row {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.75rem 2rem;
	}

	.footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.footer-links a {
		color: var(--graphite);
		text-decoration: none;
	}

	.footer-links a:hover {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>
